/**
 * Evelyn Property Hub — staged fresh database creation.
 *
 * Reads the current CRM spreadsheet.
 * Copies public/site data and the four listing sheets.
 * Creates blank CRM tables.
 * Does NOT change EPH_SPREADSHEET_ID.
 * Does NOT modify or delete the original spreadsheet.
 * Does NOT import any Google Forms responses.
 */
function createFreshEphDatabasePreview() {
  const props = PropertiesService.getScriptProperties();
  const pendingKey = 'EPH_FRESH_DATABASE_PENDING_ID';

  const sourceId =
    props.getProperty('EPH_SPREADSHEET_ID') ||
    '1udZqtcMyNuAGJ8ZU13iD_PuYPCqJOtKHc5Wh7KysZko';

  // Reuse the staged database if this function is run again.
  const pendingId = props.getProperty(pendingKey);
  if (pendingId) {
    const pending = SpreadsheetApp.openById(pendingId);
    return freshDbReport_(pending, sourceId, true);
  }

  const source = SpreadsheetApp.openById(sourceId);
  const target = SpreadsheetApp.create(
    'Evelyn Property Hub — Fresh CRM Database'
  );

  // The four listing tables and website content are preserved.
  const preserveTables = [
    'land_listings',
    'commercial_listings',
    'factory_listings',
    'house_listings',
    'site_profile',
    'site_videos',
    'site_updates'
  ];

  // These CRM tables start empty.
  const allTables = [
    'crm_leads',
    'crm_records',
    'crm_cobroke_requests',
    'crm_agreement_tracker',
    ...preserveTables,
    '__drive_files'
  ];

  // Use the default new sheet for the first blank CRM table.
  const first = target.getSheets()[0];
  first.setName('crm_leads');
  first.getRange(1, 1).setValue('id');
  first.setFrozenRows(1);

  // Copy only approved listing/site tabs; never copy old CRM records.
  const copied = [];
  const missingSourceTabs = [];

  preserveTables.forEach(name => {
    const oldSheet = source.getSheetByName(name);

    if (oldSheet) {
      const newSheet = oldSheet.copyTo(target);
      newSheet.setName(name);
      copied.push(name);
    } else {
      missingSourceTabs.push(name);
      const newSheet = target.insertSheet(name);
      newSheet.getRange(1, 1).setValue('id');
      newSheet.setFrozenRows(1);
    }
  });

  // Create the remaining blank CRM/system tables.
  allTables.forEach(name => {
    if (!target.getSheetByName(name)) {
      const sh = target.insertSheet(name);
      sh.getRange(1, 1).setValue('id');
      sh.setFrozenRows(1);
    }
  });

  // Keep the new database staged; do not activate it yet.
  props.setProperty(pendingKey, target.getId());

  const report = freshDbReport_(target, sourceId, false);
  report.copiedTables = copied;
  report.missingSourceTabs = missingSourceTabs;
  report.crmTablesStartEmpty = [
    'crm_leads',
    'crm_records',
    'crm_cobroke_requests',
    'crm_agreement_tracker'
  ];
  report.activatedForLiveCRM = false;

  Logger.log(JSON.stringify(report, null, 2));
  return report;
}

