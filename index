function ephStoryExpiryMsServer_(row) {
  row = row || {};
  const nested = row.data && typeof row.data === 'object' ? row.data : {};
  const explicit = row.expires_at || row.expiresAt || nested.expires_at || nested.expiresAt;
  const explicitMs = explicit ? Date.parse(String(explicit)) : NaN;
  if (Number.isFinite(explicitMs)) return explicitMs;
  const created = row.created_at || row.createdAt || row.published_at || nested.created_at || nested.createdAt || '';
  const createdMs = created ? Date.parse(String(created)) : NaN;
  return Number.isFinite(createdMs) ? createdMs + 24 * 60 * 60 * 1000 : NaN;
}

