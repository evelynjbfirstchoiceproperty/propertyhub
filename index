/**
 * Trigger handler: unpublish expired Story posts and move their linked video-only
 * Drive files to Trash. Metadata stays in site_videos for Admin history.
 */
function ephRunStoryDriveExpiryV2() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return {ok:false,skipped:'Another EPH job is running.'};
  try {
    var p = ephStoryDlv2Candidates_(false);
    if (p.headers.length === 0) return {ok:true,expired:0,driveFilesTrashed:0,errors:[]};
    var needed = ['published','is_public','status','visibility','expired_at','unpublished_at','drive_file_id',
      'drive_file_deleted','drive_removal_status','drive_file_deleted_at','drive_file_delete_error','updated_at'];
    var headers = ephStoryDlv2EnsureHeaders_(p.sheet,p.headers,needed);
    var now = new Date();
    var nowIso = now.toISOString();
    var report = {ok:true,checked:p.scanned,expired:0,driveFilesTrashed:0,alreadyInTrash:0,
      noDriveFile:0,nonVideoProtected:0,retryPending:0,rowsUpdated:0,errors:[],checkedAt:nowIso};

    p.rows.forEach(function (item) {
      if (!item.due) return;
      var row = item.row;
      var fileId = item.fileId;
      var removalStatus = String(row.drive_removal_status || '').toLowerCase();
      var isTrashed = String(row.drive_file_deleted || '').toLowerCase() === 'true' || removalStatus === 'trashed';
      // Do not rewrite an already completed or safely protected Story every minute.
      if (isTrashed || (!fileId && removalStatus === 'no_drive_file_id') || removalStatus === 'protected_non_video') return;
      var deleteError = '';

      if (!fileId) {
        report.noDriveFile++;
        removalStatus = 'no_drive_file_id';
      } else if (isTrashed) {
        report.alreadyInTrash++;
        removalStatus = 'trashed';
      } else {
        try {
          var file = DriveApp.getFileById(fileId);
          if (file.isTrashed()) {
            isTrashed = true;
            report.alreadyInTrash++;
            removalStatus = 'trashed';
          } else if (!ephStoryDlv2IsVideoFile_(file)) {
            report.nonVideoProtected++;
            removalStatus = 'protected_non_video';
            deleteError = 'Safety check: linked Drive file is not recognised as a video; file was not trashed.';
          } else {
            file.setTrashed(true);
            isTrashed = true;
            report.driveFilesTrashed++;
            removalStatus = 'trashed';
          }
        } catch (err) {
          deleteError = String(err && err.message || err);
          removalStatus = 'retry_pending';
          report.retryPending++;
          report.errors.push({rowNumber:item.rowNumber,id:String(row.id || ''),fileId:fileId,error:deleteError});
        }
      }

      var update = {
        published:false,is_public:false,status:'Expired',visibility:'private',
        expired_at:row.expired_at || nowIso,unpublished_at:row.unpublished_at || nowIso,
        drive_file_id:fileId || row.drive_file_id || '',
        drive_file_deleted:!!isTrashed,
        drive_removal_status:removalStatus,
        drive_file_deleted_at:isTrashed ? (row.drive_file_deleted_at || nowIso) : (row.drive_file_deleted_at || ''),
        drive_file_delete_error:deleteError,
        updated_at:nowIso
      };
      try {
        var mutableCells = item.cells.slice();
        // Keep nested JSON in `data` in sync so the public REST filter sees published=false.
        ephStoryDlv2WriteRow_(p.sheet,item.rowNumber,headers,mutableCells,row,update);
        report.rowsUpdated++;
        report.expired++;
      } catch (writeErr) {
        report.ok = false;
        report.errors.push({rowNumber:item.rowNumber,id:String(row.id || ''),error:'Sheet update failed: '+String(writeErr && writeErr.message || writeErr)});
      }
    });
    SpreadsheetApp.flush();
    report.ok = report.errors.length === 0;
    console.log('EPH_STORY_DRIVE_EXPIRY_RESULT_V2 ' + JSON.stringify(report,null,2));
    return report;
  } finally {
    lock.releaseLock();
  }
}

