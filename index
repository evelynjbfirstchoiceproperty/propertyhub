  row = row || {};
  const published = row.published !== undefined ? row.published : (row.is_public !== undefined ? row.is_public : true);
  if (published === false || String(published).toLowerCase() === 'false' || String(published) === '0') return false;
  const status = String(row.status || row.public_status || row.visibility || '').toLowerCase();
  if (/expired|unpublished|draft|private|hidden/.test(status)) return false;
  const expiry = ephStoryExpiryMsServer_(row);
  return !Number.isFinite(expiry) || expiry > Date.now();
}

