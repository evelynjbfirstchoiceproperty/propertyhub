    var exists = headers.some(function (h) { return h.toLowerCase() === required.toLowerCase(); });
    if (!exists) headers.push(required);
  });

  if (headers.length > sheet.getMaxColumns()) {
    sheet.insertColumnsAfter(sheet.getMaxColumns(), headers.length - sheet.getMaxColumns());
  }
  if (headers.length !== lastCol || headers.some(function (h, i) {
    return h !== String(sheet.getRange(1, i + 1).getDisplayValue() || '').trim();
  })) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
  }
  return headers;
}

function ephApptAppendSave_(payload) {
  payload = payload || {};
  var id = ephApptAppendId_(payload.id);
  var name = ephApptAppendClean_(payload.customerName || payload.person || payload.name, 120);
  var phone = ephApptAppendClean_(payload.customerPhone || payload.phone, 60);
  var date = ephApptAppendClean_(payload.preferredDate || payload.date, 40);
  var time = ephApptAppendClean_(payload.preferredTime || payload.time, 40);
  var ref = ephApptAppendClean_(payload.listingReference || payload.ref || payload.reference, 100);
  var property = ephApptAppendClean_(payload.property || payload.propertyName, 240);
  var remark = ephApptAppendClean_(payload.remark || payload.message, 1500);

  if (!name || !phone || !date || !time || !ref) {
    throw new Error('Required fields missing: Name, Phone, Listing Reference, Preferred Date and Preferred Time.');
  }

  var now = new Date().toISOString();
  var createdAt = ephApptAppendClean_(payload.created_at || payload.createdAt, 50) || now;
  var data = {
    id: id,
    name: name,
    customerName: name,
    phone: phone,
    customerPhone: phone,
    date: date,
    preferredDate: date,
    time: time,
    preferredTime: time,
    property: property,
    ref: ref,
    listingReference: ref,
    remark: remark,
    status: 'Pending',
    kind: 'Customer Viewing',
    kindLabel: 'Customer View Appointment',
    source: 'Customer View',
    listingCategory: ephApptAppendClean_(payload.listingCategory, 60),
    listingSource: ephApptAppendClean_(payload.listingSource, 80),
    listingId: ephApptAppendClean_(payload.listingId, 100),
    listingTable: ephApptAppendClean_(payload.listingTable, 80),
    listingLocation: ephApptAppendClean_(payload.listingLocation, 240),
    listingPrice: ephApptAppendClean_(payload.listingPrice, 100),
    created_at: createdAt,
    updated_at: now
  };
  var record = { id: id, kind: 'viewing', data: JSON.stringify(data), updated_at: now };

  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) throw new Error('Another save is in progress. Please retry after a moment.');
  try {
    var sheet = getSheet_('crm_records');
    var headers = ephApptAppendEnsureColumns_(sheet, ['id', 'kind', 'data', 'updated_at']);
    var index = {};
    headers.forEach(function (h, i) { index[String(h).toLowerCase()] = i; });
    var idCol = index.id + 1;
    var lastRow = sheet.getLastRow();
    var targetRow = 0;

    // Idempotency: update the exact same VW-CUST ID rather than creating duplicates.
    if (lastRow >= 2) {
      var ids = sheet.getRange(2, idCol, lastRow - 1, 1).getDisplayValues();
      for (var i = 0; i < ids.length; i++) {
        if (String(ids[i][0]).trim() === id) {
          targetRow = i + 2;
          break;
        }
      }
    }

    if (!targetRow) targetRow = Math.max(2, lastRow + 1);
    var row = targetRow <= lastRow
      ? sheet.getRange(targetRow, 1, 1, headers.length).getValues()[0]
      : new Array(headers.length).fill('');
    row[index.id] = record.id;
    row[index.kind] = record.kind;
    row[index.data] = record.data;
    row[index.updated_at] = record.updated_at;
    sheet.getRange(targetRow, 1, 1, headers.length).setValues([row]);
    SpreadsheetApp.flush();

    return {
      ok: true,
      saved: true,
      exists: true,
      id: id,
      kind: 'viewing',
      row: targetRow,
      action: targetRow <= lastRow ? 'updated' : 'inserted'
    };
  } finally {
    lock.releaseLock();
  }
}

function ephApptAppendCheck_(rawId) {
