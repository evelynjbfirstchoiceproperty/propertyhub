  }

  const source = SpreadsheetApp.openById(sourceId);
  const target = SpreadsheetApp.openById(targetId);

  const preserveTables = [
    'land_listings',
    'commercial_listings',
    'factory_listings',
    'house_listings',
    'site_profile',
    'site_videos',
    'site_updates'
  ];

  const crmTables = [
    'crm_leads',
    'crm_records',
    'crm_cobroke_requests',
    'crm_agreement_tracker'
  ];

  const report = {
    ok: true,
    sourceSpreadsheetId: sourceId,
    stagedSpreadsheetId: targetId,
    tableChecks: {},
    crmTablesEmpty: {},
    safeToConsiderActivation: false
  };

  preserveTables.forEach(name => {
    const a = source.getSheetByName(name);
    const b = target.getSheetByName(name);

    if (!a || !b) {
      report.tableChecks[name] = {
        passed: false,
        reason: 'Missing source or target sheet'
      };
      report.ok = false;
      return;
    }

    const aRange = a.getDataRange();
    const bRange = b.getDataRange();

    const sameSize =
      aRange.getNumRows() === bRange.getNumRows() &&
      aRange.getNumColumns() === bRange.getNumColumns();

    const sameValues = sameSize &&
      JSON.stringify(aRange.getValues()) ===
      JSON.stringify(bRange.getValues());

    const sameFormulas = sameSize &&
      JSON.stringify(aRange.getFormulas()) ===
      JSON.stringify(bRange.getFormulas());

    const passed = sameSize && sameValues && sameFormulas;

    report.tableChecks[name] = {
      passed,
      sourceRows: a.getLastRow(),
      targetRows: b.getLastRow(),
      sourceColumns: a.getLastColumn(),
      targetColumns: b.getLastColumn(),
      sameSize,
      sameValues,
      sameFormulas
    };

    if (!passed) report.ok = false;
  });

  crmTables.forEach(name => {
    const sheet = target.getSheetByName(name);
    const empty = !!sheet && sheet.getLastRow() <= 1;

    report.crmTablesEmpty[name] = empty;
    if (!empty) report.ok = false;
  });

  report.safeToConsiderActivation = report.ok;

  Logger.log(JSON.stringify(report, null, 2));
  return report;
}
