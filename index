/**
 * Evelyn Property Hub — Google Form header mapping fix V5 (APPEND ONLY)
 *
 * PURPOSE
 * - Correctly map the user's three actual Google Form layouts: Buyer, Tenant,
 *   and Agent/Broker.
 * - Read the explicit classification from Role or
 *   "Which best describes you?" (including a value stored in Answers JSON).
 * - Prefer the non-empty response cell / non-empty duplicate question variant.
 * - Never mistake a country-code column for the phone number.
 * - Sync ONLY Buyer, Tenant, Agent/Broker rows.
 * - Buyer/Tenant -> crm_leads; Agent/Broker -> crm_records (kind=agent).
 * - Keep existing CRM-only fields and status when updating a matching record.
 * - No existing CRM rows are deleted by this patch.
 *
 * INSTALL
 * Append this entire file to the very bottom of the current Code.gs, below V3/V4.
 * Save, then Deploy > Manage deployments > Edit > New version > Deploy.
 * Existing ephGoogleFormResponseSyncTrigger triggers use the overridden handler.
 *
 * TEST / BACKFILL
 * 1. ephTestEphGoogleFormHeaderMappingV5()       (local sample-only test)
 * 2. ephAuditEphGoogleFormHeadersV5()            (read-only source header audit)
 * 3. ephResyncGoogleFormResponsesToCRMV5()        (syncs classified rows; dedupes)
 */

function ephFormNormHeaderV5_(value) {
  return String(value == null ? '' : value)
    .toLowerCase()
    .replace(/\s*\[\s*\d+\s*\]\s*$/, '')
    .replace(/[^a-z0-9\u4e00-\u9fff]/g, '');
}

function ephFormIsBlankV5_(value) {
  return value === null || value === undefined || String(value).trim() === '';
}

function ephFormParseAnswersV5_(raw) {
  if (raw && typeof raw === 'object' && !Array.isArray(raw)) return Object.assign({}, raw);
  if (typeof raw === 'string' && raw.trim()) {
    try {
      var parsed = JSON.parse(raw);
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) return Object.assign({}, parsed);
    } catch (err) {}
  }
  return {};
}

/** Build candidates from real columns first, then Answers JSON as fallback. */
function ephFormEntriesV5_(headers, values, answers) {
  var entries = [];
  (headers || []).forEach(function(header, index) {
    var value = values && values[index];
    if (ephFormIsBlankV5_(value)) return;
    entries.push({ key:String(header || ''), value:value, source:'sheet', index:index });
  });
  Object.keys(answers || {}).forEach(function(key) {
    var value = answers[key];
    if (ephFormIsBlankV5_(value)) return;
    entries.push({ key:String(key || ''), value:value, source:'answers', index:-1 });
  });
  return entries;
}

/** Exact header match first; suffixes like [2] are normalized away. */
function ephFormPickHeaderV5_(entries, aliases) {
  var normalizedAliases = (aliases || []).map(ephFormNormHeaderV5_).filter(Boolean);
  var sheetEntries = (entries || []).filter(function(e) { return e.source === 'sheet'; });
  var answerEntries = (entries || []).filter(function(e) { return e.source === 'answers'; });
  var groups = [sheetEntries, answerEntries];

  // Exact match, with supplied alias priority and sheet-cell priority.
  for (var a = 0; a < normalizedAliases.length; a++) {
    for (var g = 0; g < groups.length; g++) {
      for (var i = 0; i < groups[g].length; i++) {
        if (ephFormNormHeaderV5_(groups[g][i].key) === normalizedAliases[a]) return groups[g][i].value;
      }
    }
  }

  // Allow a duplicate Google Forms suffix or bilingual expansion, but avoid
  // broad matching of unrelated headers such as Country Code vs Phone.
  for (var b = 0; b < normalizedAliases.length; b++) {
    var alias = normalizedAliases[b];
    if (!alias || alias.length < 5) continue;
    for (var gg = 0; gg < groups.length; gg++) {
      for (var j = 0; j < groups[gg].length; j++) {
        var key = ephFormNormHeaderV5_(groups[gg][j].key);
        if (key === alias) return groups[gg][j].value;
        if (key.indexOf(alias) === 0 && key.length <= alias.length + 16) return groups[gg][j].value;
      }
    }
  }
  return '';
}

function ephFormRoleTokenV5_(value) {
  var text = String(value == null ? '' : value).toLowerCase();
  if (/\bagent\b|\bbroker\b|地产代理|房地产代理|经纪/.test(text)) return 'agent';
  if (/\btenant\b|\brenter\b|租客|租户|租房/.test(text)) return 'tenant';
  if (/\bbuyer\b|\bpurchaser\b|买家|买方|购房/.test(text)) return 'buyer';
  return '';
}

/** Explicit row classification only; no inference from file or tab title. */
function ephFormClassifyV5_(entries) {
  var roleValue = ephFormPickHeaderV5_(entries, ['Role', 'User Role', 'Form Role', '角色']);
  var questionValue = ephFormPickHeaderV5_(entries, [
    'Which best describes you?',
    'Which best describes you? / 您的身份是？',
    'Buyer / Tenant',
    'Buyer / Tenant / Agent',
    'Customer Type',
    'Applicant Type'
  ]);
  var role = ephFormRoleTokenV5_(roleValue);
  var questionRole = ephFormRoleTokenV5_(questionValue);

  // If both explicit fields are present but disagree, skip rather than guess.
  if (role && questionRole && role !== questionRole) {
    return { role:'', reason:'Conflicting explicit Role and Which best describes you? values.' };
  }
  if (role) return { role:role, reason:'Role column: ' + String(roleValue) };
  if (questionRole) return { role:questionRole, reason:'Which best describes you?: ' + String(questionValue) };
  return { role:'', reason:'Skipped: no explicit Buyer, Tenant, or Agent/Broker classification.' };
}

function ephFormPhoneDigitsV5_(value) {
  var digits = String(value == null ? '' : value).replace(/\D/g, '');
  if (digits.indexOf('00') === 0) digits = digits.slice(2);
  return digits;
}

function ephFormNormalizePhoneV5_(phone, countryCode) {
  var p = ephFormPhoneDigitsV5_(phone);
  var c = ephFormPhoneDigitsV5_(countryCode);
  if (p.length < 7 || p.length > 15) return '';
  if (c && p.indexOf(c) === 0) return p;
  if (c && p.charAt(0) === '0') p = p.slice(1);
  var normalized = c ? c + p : p;
  return normalized.length >= 7 && normalized.length <= 15 ? normalized : '';
}

