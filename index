/**
 * Evelyn Property Hub — Google Form CRM sync V3 (append-only patch)
 *
 * Scope: ONLY rows explicitly classified as Buyer, Tenant, or Agent/Broker.
 * Destinations: Buyer/Tenant -> crm_leads; Agent/Broker -> crm_records (kind=agent).
 * Duplicate protection: checks role + phone/email/name + submission time before insert.
 * Existing CRM records are updated in place when the same submission is found.
 * No existing rows are deleted by this patch.
 *
 * Append this file to the very bottom of the current Code.gs, then Deploy a New version.
 * Existing spreadsheet-bound triggers with handler ephGoogleFormResponseSyncTrigger
 * will call the new handler definition after deployment.
 */

function ephFormNormV3_(value) {
  return String(value == null ? '' : value)
    .toLowerCase()
    .replace(/\s*\[\s*\d+\s*\]\s*$/, '')
    .replace(/[^a-z0-9\u4e00-\u9fff]/g, '');
}

function ephFormFindColumnV3_(headers, aliases) {
  var normalized = (headers || []).map(ephFormNormV3_);
  var wanted = (aliases || []).map(ephFormNormV3_);
  for (var a = 0; a < wanted.length; a++) {
    var exact = normalized.indexOf(wanted[a]);
    if (exact >= 0) return exact;
  }
  for (var b = 0; b < wanted.length; b++) {
    if (!wanted[b]) continue;
    for (var i = 0; i < normalized.length; i++) {
      if (normalized[i] && (normalized[i].indexOf(wanted[b]) >= 0 || wanted[b].indexOf(normalized[i]) >= 0)) return i;
    }
  }
  return -1;
}

function ephFormRoleTokenV3_(value) {
  var s = String(value == null ? '' : value).toLowerCase();
  if (/\bagent\b|\bbroker\b|地产代理|房地产代理|经纪/.test(s)) return 'agent';
  if (/\btenant\b|\brenter\b|租客|租户|租房/.test(s)) return 'tenant';
  if (/\bbuyer\b|\bpurchaser\b|买家|买方|购房/.test(s)) return 'buyer';
  return '';
}

function ephFormRoleFromTitleV3_(sourceSpreadsheet, sourceSheet) {
  var title = (String(sourceSpreadsheet && sourceSpreadsheet.getName() || '') + ' ' +
    String(sourceSheet && sourceSheet.getName() || '')).toLowerCase();
  var found = [];
  if (/\bbuyer\b|买家|买方/.test(title)) found.push('buyer');
  if (/\btenant\b|\brenter\b|租客|租户/.test(title)) found.push('tenant');
  if (/\bagent\b|\bbroker\b|经纪|地产代理/.test(title)) found.push('agent');
  return found.length === 1 ? found[0] : '';
}

/** Strictly recognizes Google Form response sheets; does not use generic CRM tabs. */
function ephFormIsApprovedResponseSheetV3_(sheet) {
  if (!sheet || sheet.getLastColumn() < 2 || sheet.getLastRow() < 1) return false;
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];
  var hasTimestamp = ephFormFindColumnV3_(headers, ['Timestamp', '时间戳', 'Submitted At', '提交时间']) >= 0;
  if (!hasTimestamp) return false;
  var hasFormRole = ephFormFindColumnV3_(headers, [
    'Role', 'User Role', 'Which best describes you?',
    'Which best describes you? / 您的身份是？', 'Buyer / Tenant',
    'Buyer / Tenant / Agent', 'Customer Type', 'Applicant Type', 'Form Role'
  ]) >= 0;
  var hasFormMarker = ephFormFindColumnV3_(headers, [
    'Answers JSON', '完整答案', 'Form Response ID', 'EPH Source Key'
  ]) >= 0;
  var titleRole = ephFormRoleFromTitleV3_(sheet.getParent(), sheet);
  // Must resemble a Form response sheet, and be classifiable by response role or a role-specific title.
  return hasFormRole || (hasFormMarker && titleRole !== '') || titleRole !== '';
}

/** Reads only explicit role answers. If those are blank, only a single-role sheet title is accepted. */
function ephFormClassifyRoleV3_(sourceSpreadsheet, sourceSheet, headers, values) {
  var roleAliases = [
    'Role', 'User Role', 'Form Role', 'Which best describes you?',
    'Which best describes you? / 您的身份是？', 'Buyer / Tenant',
    'Buyer / Tenant / Agent', 'Customer Type', 'Applicant Type', '身份', '角色'
  ];
  for (var i = 0; i < roleAliases.length; i++) {
    var col = ephFormFindColumnV3_(headers, [roleAliases[i]]);
    if (col < 0) continue;
    var text = String(values && values[col] != null ? values[col] : '').trim();
    if (!text) continue;
    var token = ephFormRoleTokenV3_(text);
    if (token) return { role: token, reason: 'Explicit Google Sheet role answer: ' + String(headers[col]) };
  }
  var titleRole = ephFormRoleFromTitleV3_(sourceSpreadsheet, sourceSheet);
  if (titleRole) return { role: titleRole, reason: 'Role-specific response spreadsheet/tab title' };
  return { role: '', reason: 'Skipped: row is not explicitly classified as Buyer, Tenant, or Agent/Broker.' };
}

function ephFormParseAnswersV3_(raw) {
  if (raw && typeof raw === 'object' && !Array.isArray(raw)) return Object.assign({}, raw);
  if (typeof raw === 'string' && raw.trim()) {
    try {
      var parsed = JSON.parse(raw);
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) return Object.assign({}, parsed);
    } catch (e) {}
  }
  return {};
}

/** Picks the first non-empty value among duplicate-labelled columns such as Full Name [2]. */
function ephFormPickV3_(data, aliases) {
  var keys = Object.keys(data || {});
  var normalized = keys.map(ephFormNormV3_);
  var wanted = (aliases || []).map(ephFormNormV3_);
  for (var a = 0; a < wanted.length; a++) {
    for (var i = 0; i < keys.length; i++) {
      if (normalized[i] === wanted[a] && data[keys[i]] !== '' && data[keys[i]] != null) return data[keys[i]];
    }
  }
  for (var b = 0; b < wanted.length; b++) {
    if (!wanted[b]) continue;
    for (var j = 0; j < keys.length; j++) {
      if (normalized[j] && (normalized[j].indexOf(wanted[b]) === 0 || wanted[b].indexOf(normalized[j]) === 0) &&
          data[keys[j]] !== '' && data[keys[j]] != null) return data[keys[j]];
    }
  }
  return '';
}

function ephFormDigitsV3_(value) {
  return String(value == null ? '' : value).replace(/\D/g, '');
}

function ephFormNormalizePhoneV3_(phone, countryCode) {
  var p = ephFormDigitsV3_(phone);
  var c = ephFormDigitsV3_(countryCode);
  if (!p) return '';
  if (p.indexOf('00') === 0) p = p.slice(2);
  if (c && p.indexOf(c) === 0) return p;
  if (c && p.indexOf('0') === 0) p = p.slice(1);
  return c ? c + p : p;
}

function ephFormNameKeyV3_(value) {
  return String(value == null ? '' : value).toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]/g, '');
}

function ephFormTimestampMsV3_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) return value.getTime();
  if (value == null || value === '') return 0;
  var s = String(value).trim();
  // Interpret common Google Sheets display timestamps in the Apps Script project timezone.
  var m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})\s+(\d{1,2}):(\d{2})(?::(\d{2}))?/);
  if (m) return new Date(Number(m[3]), Number(m[1]) - 1, Number(m[2]), Number(m[4]), Number(m[5]), Number(m[6] || 0)).getTime();
  var parsed = new Date(s).getTime();
  return isNaN(parsed) ? 0 : parsed;
}

function ephFormDataRoleV3_(data, outerRow) {
  var role = ephFormRoleTokenV3_(data && (data._eph_role || data.role || data.type || data.lead_type || data.customer_type));
  if (!role && outerRow && String(outerRow.kind || '').toLowerCase() === 'agent') role = 'agent';
  return role;
}

function ephFormIdentityV3_(data, outerRow) {
  data = data || {};
  var role = ephFormDataRoleV3_(data, outerRow);
  var name = ephFormPickV3_(data, [
    'Full Name / 姓名', 'Full Name', 'Name', 'Buyer Name', 'Tenant Name',
    'Agent / Broker Name / 经纪姓名', 'Agent / Broker Name', 'Applicant Name', 'Contact Name', '姓名'
  ]);
  var email = ephFormPickV3_(data, ['Email Address / 电邮', 'Email Address', 'Email', 'Email Address / 电邮地址', '电邮地址']);
  var phone = ephFormPickV3_(data, [
    'Buyer WhatsApp / Phone Number', 'Tenant WhatsApp / Phone Number', 'Agent WhatsApp / Phone Number',
    'WhatsApp / Phone Number', 'Phone / WhatsApp Number', 'Phone / WhatsApp', 'Phone Number', 'WhatsApp Number', 'Mobile Number', 'Phone', 'Mobile', '电话或 WhatsApp 号码', '电话 / WhatsApp'
  ]);
  var country = ephFormPickV3_(data, [
    'Country Code (WhatsApp / Phone)', 'Country Code (Phone / WhatsApp)',
    'Country Code / 国际区号', 'Country Code', '电话国际区号', '国际区号'
  ]);
  var timeValue = data.formSubmittedAt || data.Timestamp || data.timestamp || data.submittedAt || data['提交时间'] ||
    (outerRow && (outerRow.created_at || outerRow.updated_at)) || '';
  return {
    role: role,
    name: ephFormNameKeyV3_(name),
    email: String(email || '').trim().toLowerCase(),
    phone: ephFormNormalizePhoneV3_(phone, country),
    timestampMs: ephFormTimestampMsV3_(timeValue)
  };
}

function ephFormSameSubmissionV3_(a, b) {
  if (!a || !b || !a.role || a.role !== b.role || !a.timestampMs || !b.timestampMs) return false;
  if (Math.abs(a.timestampMs - b.timestampMs) > 10 * 60 * 1000) return false;
  var sameName = !!(a.name && b.name && a.name === b.name);
  var samePhone = !!(a.phone && b.phone && a.phone === b.phone);
  var sameEmail = !!(a.email && b.email && a.email === b.email);
  if (samePhone && (!a.name || !b.name || sameName)) return true;
  if (sameEmail && (!a.name || !b.name || sameName)) return true;
  // If phone was stored as a number and lost its leading zero, email/name + same timestamp still works.
  if (sameName && sameEmail) return true;
  return false;
}

function ephFormParseStoredDataV3_(raw) {
  if (raw && typeof raw === 'object' && !Array.isArray(raw)) return raw;
  if (typeof raw === 'string' && raw.trim()) {
    try {
      var parsed = JSON.parse(raw);
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) return parsed;
    } catch (e) {}
  }
  return {};
}

function ephFormFindExistingSubmissionV3_(destination, candidateData, role) {
  var rows = handleRest_(destination, 'limit=10000', 'GET', null) || [];
  var candidate = ephFormIdentityV3_(candidateData, null);
  candidate.role = role;
  for (var i = 0; i < rows.length; i++) {
    var existingData = ephFormParseStoredDataV3_(rows[i].data);
    if (String(existingData.source || '').toLowerCase() !== 'google form') continue;
    var existingRole = ephFormDataRoleV3_(existingData, rows[i]);
    if (!existingRole && destination === 'crm_records' && String(rows[i].kind || '').toLowerCase() === 'agent') existingRole = 'agent';
    if (existingRole !== role) continue;
    var identity = ephFormIdentityV3_(existingData, rows[i]);
    identity.role = existingRole;
    if (ephFormSameSubmissionV3_(candidate, identity)) {
      return { row: rows[i], data: existingData, identity: identity };
    }
  }
  return null;
}

function ephFormStableIdV3_(sourceSpreadsheet, sourceSheet, headers, values, data) {
  var responseCol = ephFormFindColumnV3_(headers, ['Form Response ID (internal)', 'Form Response ID']);
  var sourceKeyCol = ephFormFindColumnV3_(headers, ['EPH Source Key']);
  var responseId = responseCol >= 0 ? String(values[responseCol] || '').trim() : '';
  var sourceKey = sourceKeyCol >= 0 ? String(values[sourceKeyCol] || '').trim() : '';
  var identity = ephFormIdentityV3_(data, null);
  var fallback = [identity.role, identity.phone, identity.email, identity.name, String(values[0] || ''), JSON.stringify(data)].join('|');
  var uniqueSource = [sourceSpreadsheet.getId(), sourceSheet.getSheetId(), sourceKey || responseId || fallback].join('|');
  var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, uniqueSource, Utilities.Charset.UTF_8);
  return 'FORM_' + Utilities.base64EncodeWebSafe(digest).replace(/=+$/g, '').slice(0, 32);
}

/** One response row -> exactly one Buyer/Tenant/Agent CRM destination. */
function ephSyncOneEphFormResponseV3_(sourceSpreadsheet, sourceSheet, rowNumber) {
  if (!sourceSpreadsheet || !sourceSheet) throw new Error('Missing Google Form source spreadsheet/sheet.');
  if (!ephFormIsApprovedResponseSheetV3_(sourceSheet)) return { synced:false, skipped:true, reason:'Not an approved Buyer/Tenant/Agent Google Form response sheet.' };
  if (rowNumber < 2 || rowNumber > sourceSheet.getLastRow()) return { synced:false, skipped:true, reason:'Not a response row.' };

  var lastCol = sourceSheet.getLastColumn();
  var headers = sourceSheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  var values = sourceSheet.getRange(rowNumber, 1, 1, lastCol).getValues()[0];
  if (!values.some(function(v) { return v !== '' && v !== null; })) return { synced:false, skipped:true, reason:'Empty response row.' };

  var roleInfo = ephFormClassifyRoleV3_(sourceSpreadsheet, sourceSheet, headers, values);
  if (!roleInfo.role) return { synced:false, skipped:true, role:'', reason:roleInfo.reason };
  var role = roleInfo.role;

  var answersCol = ephFormFindColumnV3_(headers, ['Answers JSON', 'Answers', '完整答案']);
  var data = answersCol >= 0 ? ephFormParseAnswersV3_(values[answersCol]) : {};
  // Non-empty sheet cells take priority over blank/stale JSON values.
  headers.forEach(function(header, i) {
    var name = String(header || '').trim();
    var norm = ephFormNormV3_(name);
    if (!name || values[i] === '' || values[i] === null) return;
    if (['timestamp','时间戳','submittedat','提交时间','formresponseidinternal','formresponseid','ephsourcekey','answersjson','完整答案'].indexOf(norm) >= 0) return;
    data[name] = values[i];
  });

  var nameAliases = role === 'agent'
    ? ['Agent / Broker Name / 经纪姓名', 'Agent / Broker Name', 'Full Name / 姓名', 'Full Name', 'Name', '姓名']
    : ['Full Name / 姓名', 'Full Name', 'Name', 'Buyer Name', 'Tenant Name', '姓名'];
  var phoneAliases = role === 'agent'
    ? ['Agent WhatsApp / Phone Number', 'Phone / WhatsApp Number', 'WhatsApp / Phone Number', 'Phone Number', 'Phone']
    : role === 'buyer'
      ? ['Buyer WhatsApp / Phone Number', 'WhatsApp / Phone Number', 'Phone / WhatsApp Number', 'Phone Number', 'Phone']
      : ['Tenant WhatsApp / Phone Number', 'WhatsApp / Phone Number', 'Phone / WhatsApp Number', 'Phone Number', 'Phone'];

  var name = ephFormPickV3_(data, nameAliases);
  var phone = ephFormPickV3_(data, phoneAliases);
  var email = ephFormPickV3_(data, ['Email Address / 电邮', 'Email Address', 'Email', 'Email Address / 电邮地址', '电邮地址']);
  var countryCode = ephFormPickV3_(data, ['Country Code (WhatsApp / Phone)', 'Country Code (Phone / WhatsApp)', 'Country Code / 国际区号', 'Country Code', '电话国际区号', '国际区号']);
  var agency = ephFormPickV3_(data, ['Agency / Company', 'Agency / Company / 中介公司', 'Agency', 'Company', 'Company Name', '中介公司']);
  var requirement = ephFormPickV3_(data, ['Requirement Type', 'Requirement Type / 需求类别', 'Client Requirement Type', 'Property Type', '需求类别', '房产类型']);
  var location = ephFormPickV3_(data, ['Preferred Area / Location', 'Preferred Area', 'Preferred Location', 'Preferred State', 'Location', 'Area', 'State', '意向地区', '意向州属']);
  var budget = ephFormPickV3_(data, ['Budget', 'Purchase Budget (RM)', 'Rental Budget (RM per Month)', 'Monthly Rental Budget (RM)', 'Client Budget (RM)', '购房预算', '租金预算']);

  if (name !== '' && name != null) data.name = name;
  if (phone !== '' && phone != null) data.phone = phone;
  if (email !== '' && email != null) data.email = email;
  if (countryCode !== '' && countryCode != null) data.countryCode = countryCode;
  if (agency !== '' && agency != null) data.agency = agency;
  if (requirement !== '' && requirement != null) data.requirement = requirement;
  if (location !== '' && location != null) data.location = location;
  if (budget !== '' && budget != null) data.budget = budget;

  var timestampCol = ephFormFindColumnV3_(headers, ['Timestamp', '时间戳', 'Submitted At', '提交时间']);
  var timestamp = timestampCol >= 0 ? values[timestampCol] : values[0];
  data.source = 'Google Form';
  data.role = role;
  data.type = role;
  data.lead_type = role;
  data.customer_type = role;
  data._eph_role = role;
  data.formResponseId = String((function(){ var i=ephFormFindColumnV3_(headers,['Form Response ID (internal)','Form Response ID']); return i>=0?values[i]:''; })() || '').trim();
  data.ephSourceKey = String((function(){ var i=ephFormFindColumnV3_(headers,['EPH Source Key']); return i>=0?values[i]:''; })() || '').trim();
  data.formSubmittedAt = timestamp instanceof Date ? timestamp.toISOString() : String(timestamp || new Date().toISOString());
  data.formSourceSpreadsheet = sourceSpreadsheet.getName();
  data.formSourceSpreadsheetId = sourceSpreadsheet.getId();
  data.formSourceSheet = sourceSheet.getName();
  data.formSourceSheetId = String(sourceSheet.getSheetId());
  data.formSourceRow = rowNumber;
  if (!data.status) data.status = role === 'agent' ? 'Active' : 'New';

  var destination = role === 'agent' ? 'crm_records' : 'crm_leads';
  var stableId = ephFormStableIdV3_(sourceSpreadsheet, sourceSheet, headers, values, data);
  var now = new Date().toISOString();

  // UserLock serializes this identity check across near-simultaneous form triggers.
  var lock = LockService.getUserLock();
  lock.waitLock(20000);
  try {
    var existing = ephFormFindExistingSubmissionV3_(destination, data, role);
    var resultRow;
    var created = false;
    if (existing && existing.row && existing.row.id) {
      // Preserve CRM-only fields/status while refreshing non-empty Google Form answers.
      var merged = Object.assign({}, existing.data || {});
      Object.keys(data).forEach(function(k) {
        if (data[k] !== '' && data[k] !== null && data[k] !== undefined) merged[k] = data[k];
      });
      var patch = destination === 'crm_records'
        ? { data: merged, backup_at: now }
        : { data: merged, updated_at: now };
      var updatedRows = handleRest_(destination, 'id=eq.' + encodeURIComponent(String(existing.row.id)), 'PATCH', patch);
      if (!Array.isArray(updatedRows) || !updatedRows.length) throw new Error('Matched existing CRM row could not be updated: ' + existing.row.id);
      resultRow = updatedRows[0];
    } else {
      var row = destination === 'crm_records'
        ? { id:stableId, kind:'agent', data:data, backup_at:now }
        : { id:stableId, data:data, updated_at:now };
      var inserted = handleRest_(destination, 'on_conflict=id', 'POST', row);
      if (!Array.isArray(inserted) || !inserted.length) throw new Error('CRM insert returned no row for ' + destination + ' / ' + stableId);
      resultRow = inserted[0];
      created = true;
    }

    var verifyId = String(resultRow.id || (existing && existing.row && existing.row.id) || stableId);
    var verify = handleRest_(destination, 'id=eq.' + encodeURIComponent(verifyId), 'GET', null);
    if (!Array.isArray(verify) || !verify.length) throw new Error('CRM write verification failed for ' + destination + ' / ' + verifyId);
    return {
      synced:true,
      created:created,
      updated:!created,
      duplicateMatched:!!existing,
      role:role,
