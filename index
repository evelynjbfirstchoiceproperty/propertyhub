/**
 * EPH Customer View – public listing photo folder access repair (APPEND ONLY)
 * ---------------------------------------------------------------------------
 * Paste this entire file at the VERY BOTTOM of the existing Code.gs.
 * Do not replace Code.gs and do not add a dispatch line to doGet().
 *
 * The existing doGet() photo JSONP endpoint already calls
 * isFolderInsideEphRoot_(folderId). This appended definition replaces that
 * helper's root-only rule while keeping the original root-folder behavior:
 *   1) folders inside the configured EPH root remain allowed; OR
 *   2) an external folder is allowed only when it is referenced by an active
 *      listing row AND the folder itself is shared as Anyone / Anyone with link.
 *
 * The endpoint still returns only image files that Google Drive reports as
 * publicly accessible. This does not make private folders or private files
 * public, and it does not alter CRM/listing/Story/appointment data.
 */

/** Replacement for the original root-only folder check used by doGet(). */
function isFolderInsideEphRoot_(folderId) {
  var id = String(folderId || '').trim();
  if (!/^[A-Za-z0-9_-]{15,}$/.test(id)) return false;

  try {
    var folder = DriveApp.getFolderById(id);

    // Preserve legacy permission for folders already inside EPH's own Drive root.
    if (ephCustomerPhotoV7IsWithinRoot_(folder)) return true;

    // External folders must be linked from an active listing and explicitly public.
    if (!ephCustomerPhotoV7IsLinkedToActiveListing_(id)) return false;

    var access = folder.getSharingAccess();
    return access === DriveApp.Access.ANYONE_WITH_LINK ||
           access === DriveApp.Access.ANYONE;
  } catch (err) {
    console.warn('EPH public listing photo folder check failed for ' + id + ': ' + String(err && err.message || err));
    return false;
  }
}

/** Check ancestry without changing any Drive permissions. */
function ephCustomerPhotoV7IsWithinRoot_(folder) {
  try {
    var rootId = String(EPH_ROOT_FOLDER_ID || '');
    var current = folder;
    for (var depth = 0; depth < 25 && current; depth++) {
      if (String(current.getId()) === rootId) return true;
      var parents = current.getParents();
      if (!parents.hasNext()) return false;
      current = parents.next();
    }
  } catch (err) {
    console.warn('EPH Drive folder ancestry check failed: ' + String(err && err.message || err));
  }
  return false;
}

/**
