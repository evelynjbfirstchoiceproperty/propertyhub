 */
  function ephReadCrmAlias_(table, query) {
  const ss = SpreadsheetApp.openById(
    '1udZqtcMyNuAGJ8ZU13iD_PuYPCqJOtKHc5Wh7KysZko'
  );

  let rows = [];

  if (table === 'owner_identity') {
    const sh = ss.getSheetByName('Owner Identity');
    if (!sh) throw new Error('Source sheet Owner Identity not found.');

    rows = readObjects_(sh).map(function(record) {
      let data = record.data;

      if (typeof data === 'string') {
        try {
          data = JSON.parse(data);
        } catch (e) {
          data = {};
        }
      }

      if (!data || typeof data !== 'object' || Array.isArray(data)) {
        data = {};
      }

      return Object.assign({}, data, {
        id: String(data.id || record.id || '')
      });
    });

  } else if (table === 'agent_interactions') {
    const sh = ss.getSheetByName('CRM COBROKE REQUEST');
    if (!sh) throw new Error('Source sheet CRM COBROKE REQUEST not found.');

    rows = readObjects_(sh);

  } else if (table === 'crm_leads') {
    const sh = ss.getSheetByName('CRM Lead');
    if (!sh) throw new Error('Source sheet CRM Lead not found.');

    rows = readObjects_(sh).map(function(record) {
      let data = record.data;

      if (typeof data === 'string') {
        try {
          data = JSON.parse(data);
        } catch (e) {
          data = {};
        }
      }

      if (!data || typeof data !== 'object' || Array.isArray(data)) {
        data = {};
      }

      return Object.assign({}, data, {
        id: String(data.id || record.id || '')
      });
    });

  } else {
    throw new Error('Unsupported CRM alias: ' + table);
  }

  const params = parseQuery_(query || '');
  rows = rows.filter(function(record) {
    return matches_(record, params);
  });

  if (params.order) {
    const parts = params.order.split('.');
    const key = parts[0];
    const descending = parts[1] === 'desc';

    rows.sort(function(a, b) {
      const result = String(a[key] == null ? '' : a[key]).localeCompare(
        String(b[key] == null ? '' : b[key]),
        undefined,
        { numeric: true, sensitivity: 'base' }
      );
      return descending ? -result : result;
    });
  }

  const offset = Math.max(0, Number(params.offset || 0));
  const limit = Math.max(0, Math.min(10000, Number(params.limit || 1000)));

  return rows.slice(offset, offset + limit);
}
