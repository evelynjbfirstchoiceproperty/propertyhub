function ephFormFindHeader_(headers, candidates) {
  const normalized = headers.map(ephFormNormalizeHeader_);
  for (const candidate of candidates) {
    const index = normalized.indexOf(ephFormNormalizeHeader_(candidate));
    if (index >= 0) return index;
  }
  return -1;
}

function ephFormIsResponseSheet_(sheet) {
  // Google Forms response sheets normally contain Timestamp + answer columns;
  // custom tracking columns (Form Response ID / EPH Source Key) are optional.
  if (!sheet || sheet.getLastRow() < 2 || sheet.getLastColumn() < 2) return false;
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];
  const hasTimestamp = ephFormFindHeader_(headers, ['Timestamp', '时间戳']) >= 0;
  if (!hasTimestamp) return false;
  const normalized = headers.map(ephFormNormalizeHeader_);
  const hasName = normalized.some(h => /fullname|name|姓名|agentbrokername|buyername|tenantname/.test(h));
  const hasContact = normalized.some(h => /phone|whatsapp|mobile|电话|电邮|email/.test(h));
  const hasRole = normalized.some(h => /role|userrole|身份|申请类型|buyer|tenant|agent|broker|买家|租客|经纪/.test(h));
  const sheetLabel = (sheet.getParent().getName() + ' ' + sheet.getName()).toLowerCase();
  const hasFormContext = /buyer|tenant|agent|broker|requirement|property|买家|租客|经纪|需求|房产/.test(sheetLabel);
  // Accept standard Google Form response tabs without custom marker columns,
  // but require recognizable contact/role context to avoid syncing arbitrary sheets.
  return (hasName && hasContact) ||
         (normalized.includes('answersjson') && (hasRole || hasFormContext));
}

/**
 * Scans accessible Google Sheets and installs one submit trigger
 * per spreadsheet containing the standard Google Forms response headers (Timestamp + recognizable contact/role fields).
 */
function installEphGoogleFormTriggers() {
  const files = DriveApp.getFilesByType(MimeType.GOOGLE_SHEETS);
  const existing = ScriptApp.getProjectTriggers();
  const alreadyInstalled = new Set(
    existing
      .filter(t =>
        t.getHandlerFunction() === 'ephGoogleFormResponseSyncTrigger'
      )
      .map(t => t.getTriggerSourceId())
      .filter(Boolean)
  );

  const installed = [];
  const skipped = [];
  let scanned = 0;

  while (files.hasNext()) {
    const file = files.next();
    scanned++;

    try {
      const ss = SpreadsheetApp.openById(file.getId());
      const matchingSheets = ss.getSheets().filter(ephFormIsResponseSheet_);

      if (!matchingSheets.length) continue;

      if (alreadyInstalled.has(ss.getId())) {
        skipped.push(ss.getName() + ' — trigger already exists');
        continue;
      }

      ScriptApp.newTrigger('ephGoogleFormResponseSyncTrigger')
        .forSpreadsheet(ss)
        .onFormSubmit()
        .create();

      installed.push(
        ss.getName() + ' — ' +
        matchingSheets.map(s => s.getName()).join(', ')
      );

      alreadyInstalled.add(ss.getId());
    } catch (err) {
      console.warn(
        'Could not inspect spreadsheet ' + file.getName() +
        ': ' + String(err)
      );
    }
  }

  const report = {
    ok: true,
    scannedSpreadsheets: scanned,
    triggersInstalled: installed,
    alreadyInstalled: skipped,
    note: 'Standard response tabs are detected by Timestamp and recognizable name/contact/role fields; custom marker columns are optional.'
  };

  console.log(JSON.stringify(report, null, 2));
  return report;
}

