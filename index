/**
 * READ-ONLY: Compare the four Listing sheets between
 * the original database and the staged database.
 * Reports differences by cell address only; no cell contents are changed.
 */
function compareEphListingTablesReadOnly() {
  const SOURCE_ID =
    '1udZqtcMyNuAGJ8ZU13iD_PuYPCqJOtKHc5Wh7KysZko';

  // Exact staged ID from the latest audit log.
  const TARGET_ID =
    '1MMF5jYNkvUoQfrhjh14itucqvYGvcVVVGdG60UT5IIo';

  const activeId = PropertiesService.getScriptProperties()
    .getProperty('EPH_SPREADSHEET_ID');

  if (SOURCE_ID === TARGET_ID || activeId !== SOURCE_ID) {
    throw new Error(
      'STOP: Database IDs do not match the expected safe audit setup. ' +
      'No data was changed.'
    );
  }

  const source = SpreadsheetApp.openById(SOURCE_ID);
  const target = SpreadsheetApp.openById(TARGET_ID);

  const tables = [
    'land_listings',
    'commercial_listings',
    'factory_listings',
    'house_listings'
  ];

  function normalize(value) {
    if (value instanceof Date) return value.toISOString();
    if (value === null || value === undefined) return '';
    return String(value);
  }

  const report = {
    audit: 'READ_ONLY_LISTING_COMPARISON',
    sourceSpreadsheetId: source.getId(),
    targetSpreadsheetId: target.getId(),
    activePointerChanged: false,
    tables: []
  };

  tables.forEach(function(name) {
    const a = source.getSheetByName(name);
    const b = target.getSheetByName(name);

    if (!a || !b) {
      report.tables.push({
        name: name,
        status: 'MISSING_SHEET',
        sourceExists: !!a,
        targetExists: !!b
      });
      return;
    }

    const ar = a.getLastRow();
    const ac = a.getLastColumn();
    const br = b.getLastRow();
    const bc = b.getLastColumn();

    const av = ar && ac ? a.getRange(1, 1, ar, ac).getValues() : [];
    const bv = br && bc ? b.getRange(1, 1, br, bc).getValues() : [];
    const af = ar && ac ? a.getRange(1, 1, ar, ac).getFormulas() : [];
    const bf = br && bc ? b.getRange(1, 1, br, bc).getFormulas() : [];

    let valueDifferences = 0;
    let formulaDifferences = 0;
    const samples = [];

    const maxRows = Math.max(ar, br);
    const maxCols = Math.max(ac, bc);

    for (let r = 0; r < maxRows; r++) {
      for (let c = 0; c < maxCols; c++) {
        const va = r < ar && c < ac ? normalize(av[r][c]) : '';
        const vb = r < br && c < bc ? normalize(bv[r][c]) : '';
        const fa = r < ar && c < ac ? String(af[r][c] || '') : '';
        const fb = r < br && c < bc ? String(bf[r][c] || '') : '';

        if (va !== vb) {
          valueDifferences++;
          if (samples.length < 20) {
            samples.push({
              cell: a1Column_(c + 1) + (r + 1),
              difference: 'VALUE'
            });
          }
        }

        if (fa !== fb) {
          formulaDifferences++;
          if (samples.length < 20) {
            samples.push({
              cell: a1Column_(c + 1) + (r + 1),
              difference: 'FORMULA'
            });
          }
        }
      }
    }

    report.tables.push({
      name: name,
      sourceRows: ar,
      targetRows: br,
      sourceColumns: ac,
      targetColumns: bc,
      dimensionsMatch: ar === br && ac === bc,
      valueDifferences: valueDifferences,
      formulaDifferences: formulaDifferences,
      status: valueDifferences === 0 && formulaDifferences === 0
        ? 'MATCH'
        : 'REVIEW_REQUIRED',
      differenceSamples: samples
    });
  });

  const output = JSON.stringify(report, null, 2);
  console.log(output);
  Logger.log(output);
  return output;
}

function a1Column_(column) {
  let result = '';
  while (column > 0) {
    const remainder = (column - 1) % 26;
    result = String.fromCharCode(65 + remainder) + result;
    column = Math.floor((column - 1) / 26);
  }
  return result;
}

/**
 * READ-ONLY CRM structure audit.
 * Does not write, create, rename, or delete anything.
 * Outputs record counts and field names, not personal record values.
 */
function auditFreshEphCrmStructureReadOnly() {
  const TARGET_ID =
    '1MMF5jYNkvUoQfrhjh14itucqvYGvcVVVGdG60UT5IIo';

  const activeId = PropertiesService.getScriptProperties()
    .getProperty('EPH_SPREADSHEET_ID');

  if (activeId === TARGET_ID) {
    throw new Error(
      'STOP: Staged database is already the active database. ' +
      'No changes were made; review the database pointers first.'
    );
  }

  const ss = SpreadsheetApp.openById(TARGET_ID);

  function parseObject(value) {
    if (value && typeof value === 'object' && !Array.isArray(value)) {
      return value;
    }
    if (typeof value === 'string') {
      try {
        const parsed = JSON.parse(value);
        if (parsed && typeof parsed === 'object') return parsed;
      } catch (e) {}
    }
    return {};
  }

  function inspectTable(name) {
    const sh = ss.getSheetByName(name);
    if (!sh) return { name: name, exists: false };

    const values = sh.getDataRange().getValues();
    if (!values.length) {
      return { name: name, exists: true, empty: true };
    }

    const headers = values[0].map(function(v) {
      return String(v || '');
    });

    const rows = values.slice(1).filter(function(row) {
      return row.some(function(v) {
        return v !== '' && v !== null;
      });
    });

    const kindCounts = {};
    const statusCounts = {};
    const dataFieldCounts = {};
    let malformedDataCount = 0;

    rows.forEach(function(row) {
      const obj = {};
      headers.forEach(function(header, index) {
        if (header) obj[header] = row[index];
      });

      const kind = String(obj.kind || '(no kind)');
      kindCounts[kind] = (kindCounts[kind] || 0) + 1;

      const status = String(obj.status || '(no status)');
      statusCounts[status] = (statusCounts[status] || 0) + 1;

      if (Object.prototype.hasOwnProperty.call(obj, 'data')) {
        const parsed = parseObject(obj.data);
        if (Object.keys(parsed).length) {
          Object.keys(parsed).forEach(function(key) {
            dataFieldCounts[key] = (dataFieldCounts[key] || 0) + 1;
          });
        } else if (String(obj.data || '').trim()) {
          malformedDataCount++;
        }
      }
    });

    return {
      name: name,
      exists: true,
      headerColumns: headers.length,
      headers: headers,
      dataRows: rows.length,
      kindCounts: kindCounts,
      statusCounts: statusCounts,
      dataFieldNames: Object.keys(dataFieldCounts).sort(),
      malformedOrUnparsedDataRows: malformedDataCount
    };
  }

  const report = {
    audit: 'READ_ONLY_CRM_STRUCTURE',
    stagedSpreadsheetId: ss.getId(),
    activeSpreadsheetId: activeId || '(not set)',
    activePointerChanged: false,
    tables: [
      inspectTable('crm_leads'),
      inspectTable('crm_records'),
      inspectTable('crm_cobroke_requests'),
      inspectTable('crm_records_owner'),
      inspectTable('crm_agreement_tracker'),
      inspectTable('site_profile')
    ]
  };

  const output = JSON.stringify(report, null, 2);
  console.log(output);
  Logger.log(output);
  return output;
}

