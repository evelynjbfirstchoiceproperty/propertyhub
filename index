/**
 * Time-driven job: set expired story rows to unpublished and revoke anyone-with-link
 * general access on the matching Drive file. The Drive file itself is never trashed
 * or deleted, and the site_videos row remains available to Admin as an archive.
 */
function ephExpireStories24h() {
  const sh = getSheet_('site_videos');
  const lastRow = sh.getLastRow();
  const lastCol = sh.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return {ok:true, expired:0, driveAccessRevoked:0, errors:[]};
  let headers = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(v => String(v == null ? '' : v));
  const values = sh.getRange(2, 1, lastRow - 1, lastCol).getValues();
  const now = Date.now();
  const nowIso = new Date(now).toISOString();
  const patches = [];
  let revoked = 0;
  const errors = [];

  values.forEach((cells, index) => {
    if (!cellsHaveData_(ephFastObjectFromRow_(headers, cells))) return;
    const row = ephFastObjectFromRow_(headers, cells);
    const expiry = ephStoryExpiryMsServer_(row);
    if (!Number.isFinite(expiry) || expiry > now) return;
    const alreadyUnpublished = row.published === false || String(row.published).toLowerCase() === 'false' ||
      String(row.status || '').toLowerCase() === 'expired' || String(row.visibility || '').toLowerCase() === 'private';
    if (alreadyUnpublished) return;

    let revokeError = '';
    const fileId = ephStoryDriveFileId_(row);
    if (fileId) {
      try {
        const file = DriveApp.getFileById(fileId);
        const access = file.getSharingAccess();
        if (access !== DriveApp.Access.PRIVATE) {
          file.setSharing(DriveApp.Access.PRIVATE, DriveApp.Permission.VIEW);
        }
        revoked++;
      } catch (err) {
        revokeError = String(err && err.message || err);
        errors.push({id:String(row.id || ''), fileId:fileId, error:revokeError});
      }
    }
    const updated = Object.assign({}, row, {
      published:false, is_public:false, status:'Expired', visibility:'private',
      expired_at:nowIso, unpublished_at:nowIso,
      drive_file_retained:true, drive_access_revoke_error:revokeError
    });
    patches.push({rowNumber:index + 2, value:updated});
  });

  if (patches.length) {
    headers = ephFastEnsureHeaders_(sh, headers, patches.map(p => p.value));
    patches.forEach(p => ephFastWriteObjectRow_(sh, p.rowNumber, headers, p.value));
  }
  return {ok:true, expired:patches.length, driveAccessRevoked:revoked, errors:errors, checkedAt:nowIso, driveFilesDeleted:0};
}
