function ephStoryDlv2Candidates_(includeFuture) {
  if (typeof getDatabase_ !== 'function') throw new Error('getDatabase_() is missing. Add this patch to the existing EPH Apps Script project.');
  var db = getDatabase_();
  var sheet = db.getSheetByName(EPH_STORY_DRIVE_EXPIRY_V2.TABLE);
