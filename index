    props.setProperty(key, String(maxNumber));

    var result = {
      ok: true,
      lastUsed: maxNumber,
      nextExpected: 'AGBK' + String(maxNumber + 1).padStart(3, '0'),
      sequenceProperty: key,
      note: 'Only the Google Form Agent sequence counter was updated. No CRM rows were changed.'
    };

    Logger.log(JSON.stringify(result, null, 2));
    return result;

  } finally {
    lock.releaseLock();
  }
}


