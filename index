 * Install once from the Apps Script editor (select installEphStoryExpiryTrigger and Run).
 * The trigger runs as the script owner every minute. Public API reads also filter expired
 * posts immediately, so the Customer View does not wait for the next trigger run.
 */
function installEphStoryExpiryTrigger() {
  const handler = 'ephExpireStories24h';
  const existing = ScriptApp.getProjectTriggers().some(t => t.getHandlerFunction() === handler);
  if (!existing) {
    ScriptApp.newTrigger(handler).timeBased().everyMinutes(1).create();
  }
  return {ok:true, installed:true, alreadyInstalled:existing, handler:handler, intervalMinutes:1, note:'Expired stories are unpublished; Google Drive originals are retained.'};
