function ephFastSerialize_(value) {
  if (value === null || value === undefined) return '';
  return typeof value === 'object' ? JSON.stringify(value) : value;
}

function ephFastEnsureHeaders_(sh, objects) {
  let lastCol = sh.getLastColumn();
  let headers = lastCol
    ? sh.getRange(1, 1, 1, lastCol).getValues()[0].map(String)
    : ['id'];

  headers = headers.filter(Boolean);
  if (!headers.length) headers = ['id'];

  const missing = [];
  (objects || []).forEach(obj => {
    Object.keys(obj || {}).forEach(key => {
      if (!headers.includes(key) && !missing.includes(key)) {
        missing.push(key);
      }
    });
  });

  if (missing.length) {
    sh.getRange(1, headers.length + 1, 1, missing.length)
      .setValues([missing]);
    headers = headers.concat(missing);
  }

  if (sh.getLastRow() === 0) {
    sh.getRange(1, 1, 1, headers.length).setValues([headers]);
  }

  return headers;
}

function ephFastReadEntries_(sh, headers) {
  const lastRow = sh.getLastRow();
  if (lastRow < 2) return [];

  const values = sh.getRange(2, 1, lastRow - 1, headers.length)
    .getValues();

  const entries = [];

  values.forEach((row, index) => {
    if (!row.some(v => v !== '' && v !== null)) return;

    const obj = {};
    headers.forEach((header, col) => {
      if (!header) return;
      let value = row[col];

      if (typeof value === 'string' &&
          value.length &&
          (value[0] === '{' || value[0] === '[')) {
        try { value = JSON.parse(value); } catch (_) {}
      }

      obj[header] = value;
    });

    entries.push({
      rowNumber: index + 2,
      data: obj
    });
  });

  return entries;
}

function ephFastWriteEntry_(sh, headers, rowNumber, obj) {
  const values = headers.map(header =>
    ephFastSerialize_(obj[header])
  );

  sh.getRange(rowNumber, 1, 1, headers.length)
    .setValues([values]);
}

/**
 * Optimized REST handler.
 * Retains the existing GET / POST / PATCH / DELETE interface.
 */
function handleRest_(table, query, method, body) {
  const params = parseQuery_(query);

  if (method === 'GET') {
    let rows = readObjects_(getSheet_(table))
      .filter(row => matches_(row, params));

    if (params.order) {
      const [key, dir] = params.order.split('.');
      rows.sort((a, b) => {
        const av = a[key], bv = b[key];
        const cmp = String(av ?? '').localeCompare(
          String(bv ?? ''),
          undefined,
          { numeric: true, sensitivity: 'base' }
        );
        return dir === 'desc' ? -cmp : cmp;
      });
    }

    const offset = Math.max(0, Number(params.offset || 0));
    const limit = Math.max(
      0,
      Math.min(10000, Number(params.limit || 1000))
    );

    return rows.slice(offset, offset + limit);
  }

  return withScriptLock_(() => {
    const sh = getSheet_(table);
    const incoming = Array.isArray(body)
      ? body
      : (body && typeof body === 'object' ? [body] : []);

    if (method === 'POST') {
      const headers = ephFastEnsureHeaders_(sh, incoming);
      const entries = ephFastReadEntries_(sh, headers);

      if (params.on_conflict) {
        const key = String(params.on_conflict).split(',')[0];
        const appended = [];

        incoming.forEach(item => {
          const existing = entries.find(entry =>
            String(entry.data[key]) === String(item[key])
          );

          if (existing) {
            existing.data = Object.assign({}, existing.data, item);
            if (existing.rowNumber) {
              ephFastWriteEntry_(
                sh, headers, existing.rowNumber, existing.data
              );
            } else {
              appended.push(existing.data);
            }
          } else {
            const entry = { rowNumber: null, data: item };
            entries.push(entry);
            appended.push(item);
          }
        });

        if (appended.length) {
          const startRow = sh.getLastRow() + 1;
          sh.getRange(startRow, 1, appended.length, headers.length)
            .setValues(appended.map(obj =>
              headers.map(header => ephFastSerialize_(obj[header]))
            ));
        }

        return incoming;
      }

      if (incoming.length) {
        const startRow = sh.getLastRow() + 1;
        sh.getRange(startRow, 1, incoming.length, headers.length)
          .setValues(incoming.map(obj =>
            headers.map(header => ephFastSerialize_(obj[header]))
          ));
      }

      return incoming;
    }

    if (method === 'PATCH') {
      const headers = ephFastEnsureHeaders_(sh, [body || {}]);
      const entries = ephFastReadEntries_(sh, headers);
      const changed = [];

      entries.forEach(entry => {
        if (matches_(entry.data, params)) {
          entry.data = Object.assign({}, entry.data, body || {});
          changed.push(entry);
        }
      });

      // Write only matching rows; never clear or rewrite the entire sheet.
      changed.forEach(entry => {
        ephFastWriteEntry_(
          sh, headers, entry.rowNumber, entry.data
        );
      });

      return changed
        .map(entry => entry.data)
        .filter(row => matches_(row, params));
    }

    if (method === 'DELETE') {
      const headers = ephFastEnsureHeaders_(sh, []);
      const entries = ephFastReadEntries_(sh, headers);

      const rowNumbers = entries
        .filter(entry => matches_(entry.data, params))
        .map(entry => entry.rowNumber)
        .sort((a, b) => b - a);

      // Delete bottom-up so row numbers above remain valid.
      rowNumbers.forEach(rowNumber => sh.deleteRow(rowNumber));

      return { deleted: rowNumbers.length };
    }

    throw new Error('Unsupported table method: ' + method);
  });
}
