/**
 * Evelyn Property Hub — Google Form -> CRM sync repair (append-only)
 * -----------------------------------------------------------------
 * APPEND THIS WHOLE FILE to the BOTTOM of the SAME Apps Script project
 * that owns the Google Form spreadsheet triggers and serves the EPH web app.
 * Do not replace the current Code.gs and do not delete existing rows.
 *
 * Functions to run:
 *   1) ephAuditGoogleFormCrmSyncV2()       // read-only diagnostic
 *   2) ephResyncGoogleFormResponsesToCRMV2() // idempotent upsert of existing responses
 *
 * Trigger handler is also repaired in-place by the function override below.
 * Existing form responses keep their previous stable FORM_... IDs where possible.
 */

function ephFormNormV2_(value) {
  return String(value == null ? '' : value)
    .toLowerCase()
    .replace(/[\s_\-()[\]{}:/.\\?]+/g, '')
    .trim();
}

function ephFormFindColumnV2_(headers, aliases) {
  var normalized = (headers || []).map(ephFormNormV2_);
  var wanted = (aliases || []).map(ephFormNormV2_);
  for (var a = 0; a < wanted.length; a++) {
    var exact = normalized.indexOf(wanted[a]);
    if (exact >= 0) return exact;
  }
  for (var b = 0; b < wanted.length; b++) {
    if (!wanted[b]) continue;
    for (var i = 0; i < normalized.length; i++) {
      if (normalized[i] && (normalized[i].indexOf(wanted[b]) >= 0 || wanted[b].indexOf(normalized[i]) >= 0)) return i;
    }
  }
  return -1;
}

function ephFormPickV2_(data, aliases) {
  var keys = Object.keys(data || {});
  var normalized = keys.map(ephFormNormV2_);
  var wanted = (aliases || []).map(ephFormNormV2_);
  for (var a = 0; a < wanted.length; a++) {
    var i = normalized.indexOf(wanted[a]);
    if (i >= 0 && data[keys[i]] !== '' && data[keys[i]] != null) return data[keys[i]];
  }
  for (var b = 0; b < wanted.length; b++) {
    if (!wanted[b]) continue;
    for (var j = 0; j < normalized.length; j++) {
      if (normalized[j] && (normalized[j].indexOf(wanted[b]) >= 0 || wanted[b].indexOf(normalized[j]) >= 0) && data[keys[j]] !== '' && data[keys[j]] != null) return data[keys[j]];
    }
  }
  return '';
}

function ephFormRoleTokenV2_(value) {
  var s = String(value == null ? '' : value).toLowerCase();
  if (/\bagent\b|\bbroker\b|经纪|地产代理|房地产代理/.test(s)) return 'agent';
  if (/\btenant\b|\brenter\b|租客|租户|租房/.test(s)) return 'tenant';
  if (/\bbuyer\b|\bpurchaser\b|买家|买方|购房/.test(s)) return 'buyer';
  return '';
}

function ephFormClassifyRoleV2_(sourceSpreadsheet, sourceSheet, headers, values) {
  var title = String(sourceSpreadsheet.getName() || '') + ' ' + String(sourceSheet.getName() || '');
  var titleTokens = [];
  ['agent','tenant','buyer'].forEach(function(role) {
    var pattern = role === 'agent' ? /\bagent\b|\bbroker\b|经纪|地产代理/ : role === 'tenant' ? /\btenant\b|\brenter\b|租客|租户/ : /\bbuyer\b|\bpurchaser\b|买家|买方/;
    if (pattern.test(title.toLowerCase())) titleTokens.push(role);
  });
  if (titleTokens.length === 1) return { role: titleTokens[0], reason: 'Form spreadsheet/tab title' };

  var roleHeaderAliases = [
    'Role','User Role','Form Role','Lead Type','Customer Type','Applicant Type',
    'Application Type','Form Type','What are you?','Which best describes you?',
    'Which best describes you? / 您的身份是？','Buyer / Tenant','Buyer/Tenant',
    'Buyer / Tenant / Agent','Buyer/Tenant/Agent','申请类型','角色','身份','客户类型'
  ];
  var roleCol = ephFormFindColumnV2_(headers, roleHeaderAliases);
  if (roleCol >= 0 && values && values[roleCol] != null) {
    var roleValue = ephFormRoleTokenV2_(values[roleCol]);
    if (roleValue) return { role: roleValue, reason: 'Role answer column: ' + String(headers[roleCol]) };
  }

  // Some forms use a custom question title; inspect only headers that explicitly
  // ask for the customer's identity/type/role and classify that answer.
  for (var i = 0; i < headers.length; i++) {
    var h = String(headers[i] || '').toLowerCase();
    if (/(role|identity|whoareyou|whatbestdescribes|whichbestdescribes|buyer.*tenant|tenant.*buyer|客户类型|身份|角色)/.test(ephFormNormV2_(h))) {
      var detected = ephFormRoleTokenV2_(values && values[i]);
      if (detected) return { role: detected, reason: 'Role-like response column: ' + String(headers[i]) };
    }
  }

  // Separate-form detection from distinctive question labels.
  var headerBlob = (headers || []).join(' ').toLowerCase();
  var agentClue = /agent\s*\/\s*broker|agent broker name|agency\s*\/\s*company|ren\s*(no|number)|registration number|中介公司|经纪姓名/.test(headerBlob);
  var tenantClue = /tenant name|rental budget|monthly rent|move.?in date|tenancy period|租客姓名|租金预算|入住日期/.test(headerBlob);
  var buyerClue = /buyer name|purchase budget|buying budget|购房预算|买家姓名/.test(headerBlob);
  var clues = [agentClue ? 'agent' : '', tenantClue ? 'tenant' : '', buyerClue ? 'buyer' : ''].filter(Boolean);
  if (clues.length === 1) return { role: clues[0], reason: 'Distinctive form question headers' };

  // If the title itself mentions multiple roles, inspect the response's values
  // for a direct one-role answer in columns whose headers look like form type.
  for (var j = 0; j < headers.length; j++) {
    var headerNorm = ephFormNormV2_(headers[j]);
    if (/type|role|identity|applicant|customer|lookingfor|需求类别|申请类型|身份/.test(headerNorm)) {
      var token = ephFormRoleTokenV2_(values && values[j]);
      if (token) return { role: token, reason: 'Type/identity answer in ' + String(headers[j]) };
    }
  }

  return { role: '', reason: 'Could not determine whether this response is Buyer, Tenant or Agent/Broker. Add a Role/Customer Type answer or make the response spreadsheet/tab title role-specific.' };
}

function ephFormIsResponseSheet_(sheet) {
  // Header-only check allows trigger installation before the first response arrives.
  if (!sheet || sheet.getLastColumn() < 2 || sheet.getLastRow() < 1) return false;
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];
  var hasTimestamp = ephFormFindColumnV2_(headers, ['Timestamp','时间戳','Submitted At','提交时间']) >= 0;
  if (!hasTimestamp) return false;
  var normHeaders = headers.map(ephFormNormV2_);
  var hasName = normHeaders.some(function(h) { return /name|姓名|contactperson/.test(h); });
  var hasContact = normHeaders.some(function(h) { return /phone|whatsapp|mobile|telephone|email|电话|电邮/.test(h); });
  var hasAnswers = normHeaders.some(function(h) { return /answersjson|完整答案/.test(h); });
  var sourceLabel = (sheet.getParent().getName() + ' ' + sheet.getName()).toLowerCase();
  var hasFormRoleLabel = /buyer|tenant|agent|broker|买家|租客|经纪/.test(sourceLabel);
  return (hasName && hasContact) || (hasAnswers && (hasFormRoleLabel || normHeaders.length > 2));
}

function ephSyncOneEphFormResponseV2_(sourceSpreadsheet, sourceSheet, rowNumber) {
  if (!sourceSpreadsheet || !sourceSheet) throw new Error('Missing source Google Form response spreadsheet/sheet.');
  if (rowNumber < 2 || rowNumber > sourceSheet.getLastRow()) return { synced:false, reason:'Response row is outside the response data range.' };

  var lastCol = sourceSheet.getLastColumn();
  var headers = sourceSheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  var values = sourceSheet.getRange(rowNumber, 1, 1, lastCol).getValues()[0];
  if (!values.some(function(v) { return v !== '' && v !== null; })) return { synced:false, reason:'Empty response row.' };

  var data = {};
  var answersCol = ephFormFindColumnV2_(headers, ['Answers JSON','Answers','完整答案']);
  if (answersCol >= 0 && values[answersCol]) {
    try {
      var parsed = typeof values[answersCol] === 'object' ? values[answersCol] : JSON.parse(String(values[answersCol]));
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) data = Object.assign({}, parsed);
    } catch (parseError) {
      console.warn('EPH Form Sync: Answers JSON parse failed; using response columns.');
    }
  }

  headers.forEach(function(header, i) {
    var name = String(header || '').trim();
    var normalized = ephFormNormV2_(name);
    if (!name || values[i] === '' || values[i] === null) return;
    if (['timestamp','时间戳','submittedat','提交时间','formresponseid','ephsourcekey','answersjson','完整答案'].indexOf(normalized) >= 0) return;
    if (data[name] === undefined) data[name] = values[i];
  });

  var roleResult = ephFormClassifyRoleV2_(sourceSpreadsheet, sourceSheet, headers, values);
  if (!roleResult.role) {
    throw new Error('Form response not synced: ' + roleResult.reason + ' Source: ' + sourceSpreadsheet.getName() + ' / ' + sourceSheet.getName() + ' / row ' + rowNumber);
  }
  var role = roleResult.role;

  // Standardize important CRM fields while preserving every original Form answer.
  var name = ephFormPickV2_(data, [
    'name','full name','full name / 姓名','applicant name','contact name','customer name',
    'buyer name','tenant name','agent name','agent / broker name','agent / broker name / 经纪姓名',
    'agent/broker name','name of applicant','姓名','联系人姓名'
  ]);
  var phone = ephFormPickV2_(data, [
    'phone','phone number','phone / whatsapp','phone / whatsapp number','whatsapp','whatsapp number',
    'whatsapp / phone number','mobile','mobile number','contact number','telephone','tel',
    'buyer whatsapp / phone number','tenant whatsapp / phone number','agent whatsapp / phone number',
    '电话','电话号码','联系电话'
  ]);
  var email = ephFormPickV2_(data, ['email','email address','email address / 电邮','电邮','电邮地址']);
  var countryCode = ephFormPickV2_(data, ['country code','country code (phone / whatsapp)','country code (whatsapp / phone)','country code / 国际区号','电话国际区号']);
  var agency = ephFormPickV2_(data, ['agency','agency / company','agency/company','company','company name','中介公司']);
  var requirement = ephFormPickV2_(data, ['requirement','requirement type','requirement type / 需求类别','client requirement type','property type','需求类别','房产类型']);
  var location = ephFormPickV2_(data, ['preferred area / location','preferred area','preferred location','preferred state','location','area','state','意向地区','意向州属']);
  var budget = ephFormPickV2_(data, ['budget','purchase budget','purchase budget (rm)','rental budget','rental budget (rm per month)','monthly rental budget','client budget','购房预算','租金预算']);

  if (name !== '') data.name = name;
  if (phone !== '') data.phone = phone;
  if (email !== '') data.email = email;
  if (agency !== '') data.agency = agency;
  if (requirement !== '') data.requirement = requirement;
  if (location !== '') data.location = location;
  if (budget !== '') data.budget = budget;
  if (countryCode !== '') data.countryCode = countryCode;
  data.source = 'Google Form';
  data.role = role;
  data.type = role;
  data.lead_type = role;
  data.customer_type = role;
  data._eph_role = role;
  data.formResponseId = String((function(){ var i=ephFormFindColumnV2_(headers,['Form Response ID']); return i>=0?values[i]:''; })() || '').trim();
  data.ephSourceKey = String((function(){ var i=ephFormFindColumnV2_(headers,['EPH Source Key']); return i>=0?values[i]:''; })() || '').trim();
  data.formSubmittedAt = values[0] instanceof Date ? values[0].toISOString() : String(values[0] || new Date().toISOString());
  data.formSourceSpreadsheet = sourceSpreadsheet.getName();
  data.formSourceSpreadsheetId = sourceSpreadsheet.getId();
  data.formSourceSheet = sourceSheet.getName();
  data.formSourceSheetId = String(sourceSheet.getSheetId());
  data.formSourceRow = rowNumber;
  if (!data.status) data.status = role === 'agent' ? 'Active' : 'New';

  // Keep the old stable FORM_ hash format so previously imported rows are updated,
  // not duplicated, when this repair is run on existing responses.
  var responseIdIndex = ephFormFindColumnV2_(headers, ['Form Response ID']);
  var sourceKeyIndex = ephFormFindColumnV2_(headers, ['EPH Source Key']);
  var responseId = responseIdIndex >= 0 ? String(values[responseIdIndex] || '').trim() : '';
  var sourceKey = sourceKeyIndex >= 0 ? String(values[sourceKeyIndex] || '').trim() : '';
  var hashBaseData = {};
  if (answersCol >= 0 && values[answersCol]) {
    try {
      var originalParsed = typeof values[answersCol] === 'object' ? values[answersCol] : JSON.parse(String(values[answersCol]));
      if (originalParsed && typeof originalParsed === 'object' && !Array.isArray(originalParsed)) hashBaseData = Object.assign({}, originalParsed);
    } catch (ignoreParse) {}
  }
  headers.forEach(function(header, i) {
    var nm = String(header || '').trim();
    var normalized = ephFormNormV2_(nm);
    if (!nm || values[i] === '' || values[i] === null) return;
    if (['timestamp','时间戳','submittedat','提交时间','formresponseid','ephsourcekey','answersjson','完整答案'].indexOf(normalized) >= 0) return;
    if (hashBaseData[nm] === undefined) hashBaseData[nm] = values[i];
  });
  var uniqueSource = [sourceSpreadsheet.getId(), sourceSheet.getSheetId(), sourceKey || responseId || (String(values[0]) + '|' + JSON.stringify(hashBaseData))].join('|');
  var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, uniqueSource, Utilities.Charset.UTF_8);
  var stableId = 'FORM_' + Utilities.base64EncodeWebSafe(digest).replace(/=+$/g, '').slice(0, 32);

  var destination = role === 'agent' ? 'crm_records' : 'crm_leads';
  var now = new Date().toISOString();
  var row = destination === 'crm_records'
    ? { id:stableId, kind:'agent', data:data, backup_at:now }
    : { id:stableId, data:data, updated_at:now };

  // Verify destination, write result, then read the same ID back from the active database.
  var before = handleRest_(destination, 'id=eq.' + encodeURIComponent(stableId), 'GET', null);
  var writeResult = handleRest_(destination, 'on_conflict=id', 'POST', row);
  if (!Array.isArray(writeResult) || !writeResult.length) {
    throw new Error('CRM write returned no saved row for ' + destination + ' (' + stableId + ').');
  }
  var after = handleRest_(destination, 'id=eq.' + encodeURIComponent(stableId), 'GET', null);
  if (!Array.isArray(after) || !after.length || String(after[0].id) !== stableId) {
    throw new Error('CRM write could not be read back from active database ' + getDatabase_().getId() + '. Destination: ' + destination + ', ID: ' + stableId);
  }

  return {
    synced:true,
    created:!before || !before.length,
    updated:!!(before && before.length),
    role:role,
    destination:destination,
    recordId:stableId,
    displayCode:(after[0].data && (after[0].data.displayCode || after[0].data.id)) || '',
    databaseId:getDatabase_().getId(),
    sourceSpreadsheetId:sourceSpreadsheet.getId(),
    sourceSheet:sourceSheet.getName(),
    sourceRow:rowNumber,
    roleReason:roleResult.reason
  };
}

/** Repaired spreadsheet-bound trigger. Unknown role/write failures now fail visibly. */
function ephGoogleFormResponseSyncTrigger(e) {
  if (!e || !e.range || !e.source) {
    throw new Error('Missing spreadsheet Form-submit event (e.range/e.source). This must be a spreadsheet-bound On form submit trigger.');
  }
  var sheet = e.range.getSheet();
  if (!ephFormIsResponseSheet_(sheet)) {
    throw new Error('Trigger ran, but response sheet headers were not recognized: ' + e.source.getName() + ' / ' + sheet.getName());
  }
  var result = ephSyncOneEphFormResponseV2_(e.source, sheet, e.range.getRow());
  console.log('EPH_FORM_SYNC_RESULT ' + JSON.stringify(result));
  return result;
}

/**
 * Repaired trigger installer. It detects header-only Form response tabs too,
 * so installation does not depend on a test submission already existing.
 */
function installEphGoogleFormTriggers() {
  var files = DriveApp.getFilesByType(MimeType.GOOGLE_SHEETS);
  var existing = ScriptApp.getProjectTriggers();
  var existingSources = {};
  existing.forEach(function(t) {
    if (t.getHandlerFunction() === 'ephGoogleFormResponseSyncTrigger') {
      var id = t.getTriggerSourceId();
      if (id) existingSources[String(id)] = true;
    }
  });
  var report = { ok:true, scannedSpreadsheets:0, installed:[], alreadyInstalled:[], skipped:[], errors:[] };
