/** Approved response sheet: timestamp + explicit category + contact/name field. */
function ephFormIsApprovedResponseSheetV3_(sheet) {
  if (!sheet || sheet.getLastColumn() < 2 || sheet.getLastRow() < 1) return false;
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];
  var normalized = headers.map(ephFormNormHeaderV5_);
  var hasTimestamp = normalized.some(function(h) { return ['timestamp','时间戳','submittedat','提交时间'].indexOf(h) >= 0; });
  var roleAliases = [
    'Role', 'User Role', 'Form Role', 'Which best describes you?',
    'Which best describes you? / 您的身份是？', 'Buyer / Tenant',
    'Buyer / Tenant / Agent', 'Customer Type', 'Applicant Type'
  ].map(ephFormNormHeaderV5_);
  var contactAliases = [
    'Full Name', 'Full Name / 姓名', 'Agent / Broker Name',
    'Buyer WhatsApp / Phone Number', 'WhatsApp / Phone Number',
    'Agent WhatsApp / Phone Number', 'Phone / WhatsApp / 电话',
    'Email Address', 'Email'
  ].map(ephFormNormHeaderV5_);
  var hasRole = normalized.some(function(h) { return roleAliases.indexOf(h) >= 0; });
  var hasContact = normalized.some(function(h) { return contactAliases.indexOf(h) >= 0 || contactAliases.some(function(a){return h.indexOf(a)===0;}); });
  return hasTimestamp && hasRole && hasContact;
}

/** Correct identity extraction for V3/V4 duplicate detection and audit functions. */
function ephFormIdentityV3_(data, outerRow) {
  data = data || {};
  var role = ephFormRoleTokenV5_(data._eph_role || data.role || data.type || data.lead_type || data.customer_type);
  if (!role && outerRow && String(outerRow.kind || '').toLowerCase() === 'agent') role = 'agent';
  var extracted = ephFormExtractV5_(Object.keys(data), Object.keys(data).map(function(k){return data[k];}), {}, role || 'buyer');
  var timeValue = data.formSubmittedAt || data.Timestamp || data.timestamp || data.submittedAt || data['提交时间'] ||
    (outerRow && (outerRow.created_at || outerRow.updated_at)) || '';
  var identityPhone = ephFormNormalizePhoneV5_(data.phone || '', data.countryCode || data.country_code || '');
  if (!identityPhone) identityPhone = extracted.phone || ephFormNormalizePhoneV5_(extracted.phoneRaw || '', extracted.countryCode || '');
  return {
    role:role,
    name:String(data.name || data.fullName || extracted.name || '').toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]/g, ''),
    email:String(data.email || extracted.email || '').trim().toLowerCase(),
