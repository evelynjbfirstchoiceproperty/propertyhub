/**
 * Contact History CRM <-> Google Sheet bridge (append-only patch)
 * Source of truth: configured EPH database spreadsheet, crm_records tab.
 * Required columns: id | kind | data | updated_at | backup_at
 * CRM REST already reads/writes this same tab via handleRest_().
 * These utilities validate/backfill the schema and report Contact History rows.
 * No other kind is modified or deleted.
 */
function ephContactHistoryEnsureCrmRecordsSchemaV1() {
  var ss = getDatabase_();
  var sh = ss.getSheetByName('crm_records');
  if (!sh) throw new Error('Missing crm_records sheet. No changes made.');
  var required = ['id','kind','data','updated_at','backup_at'];
  var lastCol = sh.getLastColumn();
  var headers = lastCol ? sh.getRange(1,1,1,lastCol).getDisplayValues()[0].map(function(v){return String(v||'').trim();}) : [];
  if (!headers.some(Boolean)) {
    sh.getRange(1,1,1,required.length).setValues([required]);
    sh.setFrozenRows(1);
    headers = required.slice();
  } else {
    // Preserve existing column order and all data; append only missing required columns.
    required.forEach(function(h){ if (headers.indexOf(h) < 0) headers.push(h); });
    if (headers.length > sh.getMaxColumns()) sh.insertColumnsAfter(sh.getMaxColumns(),headers.length-sh.getMaxColumns());
    sh.getRange(1,1,1,headers.length).setValues([headers]);
  }
  return {ok:true, spreadsheetId:ss.getId(), sheet:'crm_records', headers:headers};
}

/** Read-only audit: confirms Contact History records are in the CRM's live database. */
function ephAuditContactHistoryCrmSheetSyncV1() {
  var schema = ephContactHistoryEnsureCrmRecordsSchemaV1();
  var sh = getSheet_('crm_records');
  var values = sh.getDataRange().getValues();
  var headers = values.length ? values[0].map(function(v){return String(v||'').trim();}) : [];
  var idCol=headers.indexOf('id'), kindCol=headers.indexOf('kind'), dataCol=headers.indexOf('data');
  if (idCol<0 || kindCol<0 || dataCol<0) throw new Error('crm_records must contain id, kind, data.');
  var count=0, ids={}, malformed=0;
  for(var r=1;r<values.length;r++){
    if(String(values[r][kindCol]||'')!=='contactHistory') continue;
    count++;
    var id=String(values[r][idCol]||'');
    if(!id || ids[id]) malformed++;
    ids[id]=true;
    var raw=values[r][dataCol];
    if(typeof raw==='string' && raw.trim()) { try { JSON.parse(raw); } catch(e) { malformed++; } }
  }
  return {ok:true, spreadsheetId:schema.spreadsheetId, sheet:'crm_records', kind:'contactHistory', rows:count, uniqueIds:Object.keys(ids).length, malformedRows:malformed, note:'CRM reads and writes this same crm_records tab through handleRest_; changes here are immediately the CRM data source.'};
}

/** Compatibility alias for a manual Google Sheet -> CRM refresh check.
 * Since CRM and Google Sheet share crm_records as the same database, no copy/import
 * is needed; running this verifies the live records and schema without duplicating rows.
 */
function syncContactHistoryGoogleSheetToCRM_V1() {
  return ephAuditContactHistoryCrmSheetSyncV1();
}
