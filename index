      // the sequence high-water mark. Manual creates always request a fresh server ID.
      if (validForPrefix && prefix !== 'AB' && prefix !== 'CB' && prefix !== 'CT') {
        ephRememberIdSequence_(prefix, Number(existingCode.slice(prefix.length)) || 0);
        data.id = existingCode;
        data.displayCode = existingCode;
        return;
      }
      if (validForPrefix && row.__ephPreserveExistingCode === true) {
        ephRememberIdSequence_(prefix, Number(existingCode.slice(prefix.length)) || 0);
        data.id = existingCode;
        data.displayCode = existingCode;
        return;
      }
      const next = ephReserveNextId_(prefix, table, recordType);
      data.id = next;
      data.displayCode = next;
      if (recordType === 'lead') {
        data.customerCode = next;
        data.customer_code = next;
      }
      if (!data.source) data.source = prefix === 'AB' || prefix === 'CB' || prefix === 'CT' ? 'Manual' : 'Google Form';
    });

    // Keep array-vs-object input shape expected by the original REST handler.
    return EPH_IDSEQ_ORIGINAL_HANDLE_REST(table, query, method, Array.isArray(body) ? incoming : incoming[0]);
  };
})();

// A global var is used deliberately so the original function can be wrapped once per runtime.
var EPH_IDSEQ_ORIGINAL_HANDLE_REST;

function ephIdSequenceKey_(prefix, spreadsheetId) {
  return 'EPH_IDSEQ_' + String(spreadsheetId || 'unknown') + '_' + String(prefix || '').toUpperCase();
}

function ephRememberIdSequence_(prefix, value) {
  const ss = getDatabase_();
  const props = PropertiesService.getScriptProperties();
  const key = ephIdSequenceKey_(prefix, ss.getId());
  const current = Number(props.getProperty(key) || 0) || 0;
  const wanted = Math.max(current, Number(value) || 0);
  if (wanted !== current) props.setProperty(key, String(wanted));
}

function ephReserveNextId_(prefix, table, recordType) {
  const ss = getDatabase_();
  const props = PropertiesService.getScriptProperties();
  const key = ephIdSequenceKey_(prefix, ss.getId());
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    let maxSeen = Number(props.getProperty(key) || 0) || 0;
    // Reconcile against existing rows as a safety net. The saved high-water mark means
    // deleting the highest-numbered record will never cause that ID to be reused.
    const sheet = ss.getSheetByName(table);
    if (sheet) {
      readObjects_(sheet).forEach(row => {
        if (recordType === 'lead') {
          const d = row.data && typeof row.data === 'object' ? row.data : {};
          const candidate = String(d.displayCode || d.customerCode || d.customer_code || d.id || row.displayCode || row.id || '').trim().toUpperCase();
          const match = candidate.match(new RegExp('^' + prefix + '(\\d+)$'));
          if (match) maxSeen = Math.max(maxSeen, Number(match[1]) || 0);
        } else {
          const d = row.data && typeof row.data === 'object' ? row.data : {};
          if (!/^(agent|broker)$/i.test(String(row.kind || ''))) return;
          const candidate = String(d.displayCode || d.id || '').trim().toUpperCase();
          const match = candidate.match(new RegExp('^' + prefix + '(\\d+)$'));
          if (match) maxSeen = Math.max(maxSeen, Number(match[1]) || 0);
        }
      });
    }
    const nextNumber = maxSeen + 1;
    props.setProperty(key, String(nextNumber));
    return prefix + String(nextNumber).padStart(3, '0');
  } finally {
    lock.releaseLock();
  }
}

/**
 * Run once to initialise sequence high-water marks for the staged fresh database.
 * It does NOT activate the database. Because the staged CRM tables are empty,
 * the expected first numbers are AB001, AGBK001, CB001, CT001, BYR001 and TNT001.
 */
function initializeFreshEphIdSequences() {
  const props = PropertiesService.getScriptProperties();
  const stagedId = props.getProperty('EPH_FRESH_DATABASE_PENDING_ID');
  if (!stagedId) throw new Error('No staged database ID found. Create and verify the fresh database first.');
  const ss = SpreadsheetApp.openById(stagedId);
  const prefixes = ['AB', 'AGBK', 'CB', 'CT', 'BYR', 'TNT'];
  const tableFor = {AB:'crm_records',AGBK:'crm_records',CB:'crm_leads',CT:'crm_leads',BYR:'crm_leads',TNT:'crm_leads'};
  const max = {};
  prefixes.forEach(p => max[p] = 0);
  prefixes.forEach(prefix => {
    const sheet = ss.getSheetByName(tableFor[prefix]);
    if (!sheet) throw new Error('Missing required CRM table: ' + tableFor[prefix]);
    readObjects_(sheet).forEach(row => {
      const d = row.data && typeof row.data === 'object' ? row.data : {};
      if ((prefix === 'AB' || prefix === 'AGBK') && !/^(agent|broker)$/i.test(String(row.kind || ''))) return;
      const code = String(d.displayCode || d.customerCode || d.customer_code || d.id || row.displayCode || row.id || '').trim().toUpperCase();
      const m = code.match(new RegExp('^' + prefix + '(\\d+)$'));
      if (m) max[prefix] = Math.max(max[prefix], Number(m[1]) || 0);
    });
    props.setProperty(ephIdSequenceKey_(prefix, ss.getId()), String(max[prefix]));
  });
  const report = {
    ok: true,
    spreadsheetName: ss.getName(),
    spreadsheetId: ss.getId(),
    activatedForLiveCRM: false,
    sequenceHighWaterMarks: max,
    nextExpectedIds: {AB:'AB001',AGBK:'AGBK001',CB:'CB001',CT:'CT001',BYR:'BYR001',TNT:'TNT001'},
    note: 'Sequence counters saved for the staged spreadsheet only. Live database pointer was not changed.'
  };
  Logger.log(JSON.stringify(report, null, 2));
  return report;
}

