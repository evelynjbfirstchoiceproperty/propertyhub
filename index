function doPost(e) {
  // RPC transport that does not depend on google.script.run's response channel.
  // The frontend submits a normal HTML form to a temporary iframe; this endpoint
  // returns a tiny page that posts the result back to the top-level CRM window.
  const params = (e && e.parameter) || {};
  if (!params.ephRpcPayload) {
    return HtmlService.createHtmlOutput('<!doctype html><meta charset="utf-8"><p>Missing ephRpcPayload.</p>');
  }
  let message;
  try {
    const req = JSON.parse(String(params.ephRpcPayload));
    const id = String(req && req.__ephRpcId || '');
    let result;
    try {
      const cleanReq = Object.assign({}, req || {});
      delete cleanReq.__ephRpcId;
      result = ephApi(cleanReq);
      message = {type:'EPH_RPC_RESPONSE', id:id, result:result};
    } catch (err) {
      message = {type:'EPH_RPC_RESPONSE', id:id, error:String(err && err.message || err)};
    }
  } catch (err) {
    message = {type:'EPH_RPC_RESPONSE', id:'', error:'Invalid RPC payload: '+String(err && err.message || err)};
  }
  const serialized = JSON.stringify(message).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
  const html = '<!doctype html><html><head><meta charset="utf-8"></head><body><script>try{top.postMessage('+serialized+', "*");}catch(e){}<\/script></body></html>';
  return HtmlService.createHtmlOutput(html).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function doGet(e) {
  const params = (e && e.parameter) || {};
    // Google Sheets/Drive RPC bridge for GitHub Pages frontend.
  if (params.bridge === '1') {
    const bridgeHtml = `<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
<script>
(function () {
  window.addEventListener('message', function (ev) {
    if (!ev.data ||
        ev.data.type !== 'EPH_RPC_REQUEST' ||
        !ev.data.id ||
        !ev.data.payload) return;

    const id = String(ev.data.id);
    const payload = ev.data.payload;

    google.script.run
      .withSuccessHandler(function (result) {
        top.postMessage({
          type: 'EPH_RPC_RESPONSE',
          id: id,
          result: result
        }, '*');
      })
      .withFailureHandler(function (err) {
        top.postMessage({
          type: 'EPH_RPC_RESPONSE',
          id: id,
          error: String(err && err.message || err)
        }, '*');
      })
      .ephApi(payload);
  });

  top.postMessage({type: 'EPH_BRIDGE_READY'}, '*');
})();
</script>
</body>
</html>`;

    return HtmlService.createHtmlOutput(bridgeHtml)
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }
  // JSONP photo-folder reader used by the existing public listing photo UI.
  // It only returns public image files in the selected Drive root folder or its subfolders.
  if (params.folderId && params.callback) {
    const callback = String(params.callback || '');
    let payload = {ok:false, photos:[]};
    if (/^[A-Za-z_$][0-9A-Za-z_$]*$/.test(callback)) {
      try {
        const folderId = String(params.folderId || '').trim();
        if (isFolderInsideEphRoot_(folderId)) {
          const folder = DriveApp.getFolderById(folderId);
          const files = folder.getFiles();
          const photos = [];
          while (files.hasNext()) {
            const file = files.next();
            const mime = String(file.getMimeType() || '');
            if (!mime.startsWith('image/')) continue;
            const access = file.getSharingAccess();
            if (access !== DriveApp.Access.ANYONE_WITH_LINK && access !== DriveApp.Access.ANYONE) continue;
            photos.push({fileName:file.getName(), name:file.getName(), url:'https://drive.google.com/uc?export=view&id='+encodeURIComponent(file.getId())});
          }
          photos.sort((a,b)=>String(a.fileName).localeCompare(String(b.fileName),undefined,{numeric:true,sensitivity:'base'}));
          payload = {ok:true, photos:photos.slice(0,5)};
        } else {
          payload = {ok:false, photos:[], error:'Photo folder is outside the configured Drive root.'};
        }
      } catch (err) {
        payload = {ok:false, photos:[], error:String(err && err.message || err)};
      }
      return ContentService.createTextOutput(callback+'('+JSON.stringify(payload)+');')
        .setMimeType(ContentService.MimeType.JAVASCRIPT);
    }
  }
  const pathInfo=String(e && e.pathInfo || '').replace(/^\/+/, '');
  if(pathInfo.startsWith('storage/v1/object/public/')) {
    const tail=pathInfo.slice('storage/v1/object/public/'.length).split('/');
    const bucket=tail.shift()||'';
    const filePath=bucket+'/'+tail.join('/');
    const mapped=findDriveMap_(filePath);
    if(!mapped || !mapped.fileId) return HtmlService.createHtmlOutput('<!doctype html><meta charset=\"utf-8\"><p>Google Drive file not found. Please upload the file again.</p>');
    const target='https://drive.google.com/uc?export=view&id='+encodeURIComponent(String(mapped.fileId));
    const html='<!doctype html><html><head><meta charset=\"utf-8\"><meta http-equiv=\"refresh\" content=\"0;url='+target+'\"></head><body><p>Opening Google Drive file…</p><script>location.replace('+JSON.stringify(target)+');</script><a href=\"'+target+'\">Open file</a></body></html>';
    return HtmlService.createHtmlOutput(html).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }
  return HtmlService.createHtmlOutput(
  '<!doctype html><html><head><meta charset="utf-8">' +
  '<meta name="viewport" content="width=device-width,initial-scale=1">' +
  '<title>Evelyn Property Hub API</title></head>' +
  '<body>Google backend is running. Open the CRM from GitHub Pages.</body></html>'
).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/** Called by google.script.run from the GitHub Pages bridge. */
function ephApi(req) {
  req = req || {};
  const action = String(req.action || '');
  const token = String(req.accessToken || '');
  if (action === 'adminLogin') return adminLogin_(String(req.email || ''), String(req.password || ''));
  if (action === 'adminLogout') return adminLogout_(token);
  if (action === 'changePassword') return changeAdminPassword_(token, String(req.password || ''));
  if (action === 'requestPasswordReset') return requestPasswordReset_(String(req.email || ''));
  if (action === 'verifyPasswordReset') return verifyPasswordReset_(String(req.email || ''), String(req.code || ''));
  if (action === 'refreshSession') return refreshSession_(String(req.refreshToken || req.accessToken || ''));
  if (action === 'health') { const folder=getRootFolder_(); return {ok:true, service:'Evelyn Property Hub Google backend', driveFolderName:folder.getName(), driveFolderUrl:folder.getUrl(), time:new Date().toISOString()}; }
  if (action === 'whoami') return {ok:true, user:validateGoogleUser_(token, false)};
  if (action === 'adminCheck') return {ok:true, user:validateGoogleUser_(token, true)};
  if (action === 'rest') {
    const table = String(req.table || '');
    if (!EPH_TABLES.has(table) || table === '__drive_files') throw new Error('Table is not allowed: ' + table);
    const method = String(req.method || 'GET').toUpperCase();
    if (!['GET','POST','PATCH','DELETE','PUT'].includes(method)) throw new Error('Unsupported method.');
    if (table === 'crm_cobroke_requests' && method === 'POST') {
      if (token) validateGoogleUser_(token, true);
      return savePublicCobrokeRequest_(req.body);
    }
    if (table === 'crm_records' && method === 'POST' && !token && isPublicViewing_(req.body)) {
      return savePublicViewing_(req.body);
    }
    if (method !== 'GET' || !EPH_PUBLIC_TABLES.has(table)) validateGoogleUser_(token, true);
    if (table === 'owner_identity' || table === 'agent_interactions') {
  if (method !== 'GET') {
    throw new Error('CRM alias is read-only during migration: ' + table);
  }
  return ephReadCrmAlias_(table, String(req.query || ''));
}
    const restResult = handleRest_(table, String(req.query || ''), method === 'PUT' ? 'PATCH' : method, req.body);
    if (!token && method === 'GET' && table === 'site_videos' && Array.isArray(restResult)) {
      return restResult.filter(ephStoryIsPublicActiveServer_);
    }
    return restResult;
  }
  if (action === 'storageStart') {
    validateGoogleUser_(token, true);
    return startDriveResumableUpload_(req);
  }
  if (action === 'storageChunk') {
    validateGoogleUser_(token, true);
    return uploadDriveResumableChunk_(req);
  }
  if (action === 'storage') {
    const storageMethod=String(req.method||'GET').toUpperCase();
    const storagePath=String(req.path||'').replace(/^\/+/, '');
    const mapped=storageMethod==='GET'?findDriveMap_(storagePath):null;
    if(!(storageMethod==='GET' && mapped && String(mapped.public)==='yes')) validateGoogleUser_(token, true);
    return handleStorage_(req);
  }
  if (action === 'migrateBatch') {
    validateGoogleUser_(token, true);
    const table = String(req.table || '');
    if (!EPH_MIGRATION_TABLES.has(table)) throw new Error('Migration table is not allowed: ' + table);
    const rows = Array.isArray(req.rows) ? req.rows : [];
    if (rows.length > 500) throw new Error('Batch is too large; send at most 500 rows per request.');
    return {ok:true, table:table, count:upsertRows_(table, rows)};
  }
  throw new Error('Unknown API action: ' + action);
}

function adminAllowedEmails_() {
  const configured = PropertiesService.getScriptProperties().getProperty('GOOGLE_ADMIN_EMAILS');
  return String(configured || EPH_ADMIN_DEFAULT).split(/[;,\s]+/).map(x=>x.trim().toLowerCase()).filter(Boolean);
}
function ephPasswordHash_(password, salt) {
  let value = String(salt) + ':' + String(password);
  for (let i=0; i<12000; i++) {
    const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, value, Utilities.Charset.UTF_8);
    value = Utilities.base64EncodeWebSafe(bytes).replace(/=+$/,'');
  }
  return value;
}
/** Run once after setting EPH_ADMIN_INITIAL_PASSWORD in Script Properties.
 * Stores a salted hash, then removes the plaintext initial password property.
 */
function initializeEphAdminPassword() {
  const props = PropertiesService.getScriptProperties();
  const initialPassword = props.getProperty('EPH_ADMIN_INITIAL_PASSWORD') || '';
  if (initialPassword.length < 8) throw new Error('Set EPH_ADMIN_INITIAL_PASSWORD (at least 8 characters) in Script Properties first.');
  const salt = Utilities.getUuid() + Utilities.getUuid();
  props.setProperty('EPH_ADMIN_PASSWORD_SALT', salt);
  props.setProperty('EPH_ADMIN_PASSWORD_HASH', ephPasswordHash_(initialPassword, salt));
  props.deleteProperty('EPH_ADMIN_INITIAL_PASSWORD');
  return {ok:true,message:'Admin password initialized and stored as a salted hash.'};
}
function adminLogin_(email, password) {
  email = String(email || '').trim().toLowerCase();
  password = String(password || '');
  if (!adminAllowedEmails_().includes(email)) throw new Error('This email is not authorized for Admin access.');
  // Use the stored salted hash after initialization/password change; otherwise use the configured initial password.
  const props = PropertiesService.getScriptProperties();
  let valid = false;
  const storedHash = props.getProperty('EPH_ADMIN_PASSWORD_HASH') || '';
  const storedSalt = props.getProperty('EPH_ADMIN_PASSWORD_SALT') || '';
  if (storedHash && storedSalt) {
    valid = ephPasswordHash_(password, storedSalt) === storedHash;
  } else {
    const initialPassword = props.getProperty('EPH_ADMIN_INITIAL_PASSWORD') || '';
    valid = Boolean(initialPassword) && ephPasswordHash_(password, 'EPH_INITIAL_PASSWORD_V1') === ephPasswordHash_(initialPassword, 'EPH_INITIAL_PASSWORD_V1');
  }
  const lockKey = 'eph_login_fail_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,email)).slice(0,24);
  const cache = CacheService.getScriptCache();
  const failures = Number(cache.get(lockKey) || 0);
  if (failures >= 5) throw new Error('Too many failed attempts. Wait 10 minutes before trying again.');
  if (!valid) { cache.put(lockKey, String(failures + 1), 600); throw new Error('Email or password is incorrect.'); }
  cache.remove(lockKey);
  const accessToken = Utilities.getUuid() + '.' + Utilities.getUuid();
  const user = {email:email, name:email};
  cache.put('eph_session_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,accessToken)).slice(0,40), JSON.stringify(user), 21600);
  return {ok:true, accessToken:accessToken, expiresIn:21600, user:user};
}
function refreshSession_(accessToken) {
  if (!accessToken || accessToken.indexOf('.') < 0) throw new Error('Session expired. Please sign in again.');
  const sessionKey = 'eph_session_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,accessToken)).slice(0,40);
  const sessionText = CacheService.getScriptCache().get(sessionKey);
  if (!sessionText) throw new Error('Session expired. Please sign in again.');
  const user = JSON.parse(sessionText);
  if (!adminAllowedEmails_().includes(String(user.email || '').toLowerCase())) throw new Error('Admin session is not authorized. Please sign in again.');
  CacheService.getScriptCache().put(sessionKey, sessionText, 21600);
  return {ok:true, accessToken:accessToken, expiresIn:21600, user:user};
}

function adminLogout_(accessToken) {
  if(accessToken && accessToken.indexOf('.')>0) {
    const key='eph_session_'+Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,accessToken)).slice(0,40);
    CacheService.getScriptCache().remove(key);
  }
  return {ok:true};
}
function changeAdminPassword_(accessToken, password) {
  const user=validateGoogleUser_(accessToken,true);
  password=String(password||'');
  if(password.length<8) throw new Error('Password must be at least 8 characters.');
  const props=PropertiesService.getScriptProperties(), salt=Utilities.getUuid()+Utilities.getUuid();
  props.setProperty('EPH_ADMIN_PASSWORD_SALT',salt);
  props.setProperty('EPH_ADMIN_PASSWORD_HASH',ephPasswordHash_(password,salt));
  props.deleteProperty('EPH_ADMIN_INITIAL_PASSWORD');
  return {ok:true,email:user.email};
}
function resetOtpKey_(email) {
  return 'eph_reset_'+Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(email||'').trim().toLowerCase())).slice(0,36);
}
function requestPasswordReset_(email) {
  email=String(email||'').trim().toLowerCase();
  if(!email) throw new Error('Enter the authorized admin email address.');
  if(!adminAllowedEmails_().includes(email)) return {ok:true,message:'If the address is authorized, a reset code will be sent.'};
  const code=String(Math.floor(100000+Math.random()*900000));
  CacheService.getScriptCache().put(resetOtpKey_(email),code,600);
  MailApp.sendEmail({to:email,subject:'Evelyn Property Hub password reset code',body:'Your Evelyn Property Hub password reset code is '+code+'. It expires in 10 minutes. If you did not request this, ignore this email.'});
  return {ok:true,message:'A reset code has been sent to the authorized admin email.'};
}
function verifyPasswordReset_(email, code) {
  email=String(email||'').trim().toLowerCase(); code=String(code||'').trim();
  if(!adminAllowedEmails_().includes(email)) throw new Error('Reset code is invalid or expired.');
  const cache=CacheService.getScriptCache(), key=resetOtpKey_(email), expected=cache.get(key);
  if(!expected || expected!==code) throw new Error('Reset code is invalid or expired.');
  cache.remove(key);
  const accessToken=Utilities.getUuid()+'.'+Utilities.getUuid(), user={email:email,name:email};
  const sessionKey='eph_session_'+Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,accessToken)).slice(0,40);
  cache.put(sessionKey,JSON.stringify(user),21600);
  return {ok:true,accessToken:accessToken,expiresIn:21600,user:user};
}

function validateGoogleUser_(accessToken, requireAdmin) {
  // Email/password login sessions are issued server-side and cached for six hours.
  if (accessToken && accessToken.indexOf('.') > 0) {
    const sessionKey = 'eph_session_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,accessToken)).slice(0,40);
    const sessionText = CacheService.getScriptCache().get(sessionKey);
    if (sessionText) {
      let sessionUser = null; try { sessionUser = JSON.parse(sessionText); } catch (_) {}
      const sessionEmail = String(sessionUser && sessionUser.email || '').toLowerCase();
      if (!sessionEmail || (requireAdmin && !adminAllowedEmails_().includes(sessionEmail))) throw new Error('Admin session is not authorized. Please sign in again.');
      return {email:sessionEmail, name:String(sessionUser.name || sessionEmail), picture:''};
    }
  }

  if (!accessToken) throw new Error('Please sign in with your authorized Google account.');
  const cache = CacheService.getScriptCache();
  const cacheKey = 'eph_google_' + accessToken.slice(-32);
  let user = null;
  const cached = cache.get(cacheKey);
  if (cached) { try { user = JSON.parse(cached); } catch (_) {} }
  if (!user) {
    const res = UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo?access_token=' + encodeURIComponent(accessToken), {muteHttpExceptions:true});
    if (res.getResponseCode() !== 200) throw new Error('Google sign-in expired. Please sign in again.');
    user = JSON.parse(res.getContentText() || '{}');
    const expectedClientId = PropertiesService.getScriptProperties().getProperty('GOOGLE_OAUTH_CLIENT_ID') || '';
    if (!expectedClientId) throw new Error('Google OAuth is not configured. Set GOOGLE_OAUTH_CLIENT_ID in Apps Script → Project Settings → Script Properties.');
    if (![String(user.aud || ''),String(user.azp || '')].includes(expectedClientId)) throw new Error('Google OAuth Client ID does not match this deployment.');
    if (!user.email || String(user.email_verified) !== 'true') throw new Error('Google did not verify the account email.');
    cache.put(cacheKey, JSON.stringify({email:user.email, email_verified:user.email_verified, aud:user.aud, azp:user.azp}), Math.max(60, Math.min(300, Number(user.expires_in || 300))));
  }
  const email = String(user.email || '').trim().toLowerCase();
  if (!email) throw new Error('Google account email is unavailable.');
  if (requireAdmin) {
    const configured = PropertiesService.getScriptProperties().getProperty('GOOGLE_ADMIN_EMAILS');
    const allow = String(configured || EPH_ADMIN_DEFAULT)
      .split(/[;,\s]+/).map(x=>x.trim().toLowerCase()).filter(Boolean);
    if (!allow.length) throw new Error('Admin access is not configured yet. Set GOOGLE_ADMIN_EMAILS in Apps Script → Project Settings → Script Properties.');
    if (!allow.includes(email)) throw new Error('This Google account is not on the Evelyn Property Hub admin allowlist: ' + email);
  }
  return {email:email, name:String(user.name || ''), picture:String(user.picture || '')};
}

function isFolderInsideEphRoot_(folderId) {
  const wanted = String(folderId || '').trim();
  if (!wanted) return false;
  const rootId = String(EPH_ROOT_FOLDER_ID);
  let current = DriveApp.getFolderById(wanted);
  for (let depth = 0; depth < 25; depth++) {
    if (String(current.getId()) === rootId) return true;
    const parents = current.getParents();
    if (!parents.hasNext()) return false;
    current = parents.next();
  }
  return false;
}
function getRootFolder_() {
  try { return DriveApp.getFolderById(EPH_ROOT_FOLDER_ID); }
  catch (e) { throw new Error('Cannot access the selected Google Drive folder. Open it while signed in as the Apps Script owner and grant that account Editor access. Folder ID: ' + EPH_ROOT_FOLDER_ID); }
}
function getDatabase_() {
  // Use only the explicitly configured spreadsheet. Never silently create a blank replacement
  // if the configured ID is inaccessible, because that can make existing CRM data appear lost.
  const props = PropertiesService.getScriptProperties();
  const configuredId = props.getProperty('EPH_SPREADSHEET_ID') || EPH_DEFAULT_SPREADSHEET_ID;
  let ss;
  try {
    ss = SpreadsheetApp.openById(configuredId);
  } catch (e) {
    throw new Error('Cannot open the configured Google Sheets database (ID: ' + configuredId + '). Check that the Apps Script owner has access. No replacement spreadsheet was created. Details: ' + e.message);
  }
  props.setProperty('EPH_SPREADSHEET_ID', configuredId);
  EPH_TABLES.forEach(name => ensureSheet_(ss, name));
  return ss;
}
function ensureSheet_(ss, name) {
  let sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  if (sh.getLastRow() === 0) sh.getRange(1,1,1,1).setValues([['id']]);
  return sh;
}
function getSheet_(table) { return ensureSheet_(getDatabase_(), table); }
function readObjects_(sh) {
  const values = sh.getDataRange().getValues();
  if (values.length < 2) return [];
  const headers = values[0].map(v=>String(v||''));
  return values.slice(1).filter(row=>row.some(v=>v!=='' && v!==null)).map(row=>{
    const obj={}; headers.forEach((h,i)=>{if(!h)return;let v=row[i]; if(typeof v==='string' && v.length && (v[0]==='{' || v[0]==='[')){try{v=JSON.parse(v)}catch(_){}} obj[h]=v;}); return obj;
  });
}
function serialCell_(v) { if (v===null || v===undefined) return ''; if (typeof v==='object') return JSON.stringify(v); return v; }
function writeObjects_(sh, rows) {
  const oldHeaders = sh.getLastColumn() ? sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String) : ['id'];
  const headers = oldHeaders.filter(Boolean);
  rows.forEach(o=>Object.keys(o||{}).forEach(k=>{if(!headers.includes(k))headers.push(k)}));
  if (!headers.length) headers.push('id');
  sh.clearContents();
  sh.getRange(1,1,1,headers.length).setValues([headers]);
  if(rows.length) sh.getRange(2,1,rows.length,headers.length).setValues(rows.map(o=>headers.map(h=>serialCell_(o[h]))));
  sh.setFrozenRows(1);
}
function parseQuery_(query) {
  const out={}; String(query||'').replace(/^\?/,'').split('&').filter(Boolean).forEach(part=>{const i=part.indexOf('=');const k=decodeURIComponent(i<0?part:part.slice(0,i));const v=decodeURIComponent((i<0?'':part.slice(i+1)).replace(/\+/g,' '));out[k]=v;}); return out;
}
function matches_(row, params) {
  return Object.keys(params).every(k=>{
    if(['select','order','offset','limit','on_conflict'].includes(k))return true;
    const m=String(params[k]).match(/^(eq|neq|gt|gte|lt|lte|is|ilike|like)\.(.*)$/s);
    if(!m)return true; const op=m[1], expected=m[2], actual=row[k];
    if(op==='is') return expected==='null' ? (actual===null||actual==='') : String(actual)===expected;
    if(op==='eq')return String(actual)===expected;
    if(op==='neq')return String(actual)!==expected;
    if(op==='gt')return Number(actual)>Number(expected);
    if(op==='gte')return Number(actual)>=Number(expected);
    if(op==='lt')return Number(actual)<Number(expected);
    if(op==='lte')return Number(actual)<=Number(expected);
    const a=String(actual||'').toLowerCase(), b=expected.replace(/^\*|\*$/g,'').toLowerCase();
    return op==='ilike'||op==='like' ? a.includes(b) : true;
  });
}
