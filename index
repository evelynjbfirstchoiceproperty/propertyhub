/** Tighter duplicate guard: exact source key/response ID, or same identity within 2 minutes. */
function ephFormSameSubmissionV3_(a, b) {
  if (!a || !b || !a.role || a.role !== b.role) return false;
  if (a.sourceKey && b.sourceKey && a.sourceKey === b.sourceKey) return true;
  if (a.responseId && b.responseId && a.responseId === b.responseId) return true;
  if (!a.timestampMs || !b.timestampMs || Math.abs(a.timestampMs - b.timestampMs) > 2 * 60 * 1000) return false;
  var sameName = !!(a.name && b.name && a.name === b.name);
  var samePhone = !!(a.phone && b.phone && a.phone === b.phone);
  var sameEmail = !!(a.email && b.email && a.email === b.email);
  return sameName && (samePhone || sameEmail);
}

/** Main row sync override: explicit classification and exact role-specific mapping. */
function ephSyncOneEphFormResponseV3_(sourceSpreadsheet, sourceSheet, rowNumber) {
  if (!sourceSpreadsheet || !sourceSheet) throw new Error('Missing Google Form source spreadsheet/sheet.');
  if (!ephFormIsApprovedResponseSheetV3_(sourceSheet)) {
    return { synced:false, skipped:true, reason:'Not a timestamp + explicit role + contact Google Form response sheet.' };
  }
  if (rowNumber < 2 || rowNumber > sourceSheet.getLastRow()) return { synced:false, skipped:true, reason:'Not a response row.' };

  var lastCol = sourceSheet.getLastColumn();
  var headers = sourceSheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  var values = sourceSheet.getRange(rowNumber, 1, 1, lastCol).getValues()[0];
  if (!values.some(function(v){ return !ephFormIsBlankV5_(v); })) return { synced:false, skipped:true, reason:'Empty response row.' };

  var answersIndex = -1;
  for (var ai = 0; ai < headers.length; ai++) {
    var hn = ephFormNormHeaderV5_(headers[ai]);
    if (hn.indexOf('answersjson') === 0 || hn === '完整答案' || hn === 'answers') { answersIndex = ai; break; }
  }
  var answers = answersIndex >= 0 ? ephFormParseAnswersV5_(values[answersIndex]) : {};
  var entries = ephFormEntriesV5_(headers, values, answers);
  var roleInfo = ephFormClassifyV5_(entries);
  if (!roleInfo.role) return { synced:false, skipped:true, role:'', reason:roleInfo.reason };
  var role = roleInfo.role;
  var extracted = ephFormExtractV5_(headers, values, answers, role);

  // Permanent skip for the two Agent/Broker submissions the user deleted.
  // This runs inside the active sync function before any CRM upsert/write.
  if (role === 'agent' || role === 'broker') {
    var blockedAgentNames = {
      'jamesissachar': '167160462',
      'fakrul': '175256754'
    };
    var blockedName = String(extracted.name || '').toLowerCase()
      .replace(/[^a-z0-9\\u4e00-\\u9fff]/g, '');
    var blockedPhone = String(extracted.phone || extracted.phoneRaw || '')
      .replace(/\\D/g, '');
    var blockedExpectedPhone = blockedAgentNames[blockedName] || '';
    if (blockedExpectedPhone && blockedPhone.indexOf(blockedExpectedPhone) !== -1) {
      return {
        synced: false,
        skipped: true,
        role: role,
        reason: 'Deleted Agent/Broker submission blocked before CRM write.'
      };
    }
  }

  // Build full source payload, preserving original answer fields and non-empty
  // sheet cells. Suffix duplicate fields are retained as separate JSON keys.
  var data = Object.assign({}, answers);
  headers.forEach(function(header, index) {
    var key = String(header || '').trim();
    var value = values[index];
    if (!key || ephFormIsBlankV5_(value)) return;
    data[key] = value;
  });

  if (extracted.name) {
    data.name = extracted.name;
    data.fullName = extracted.name;
  }
  if (extracted.phone) {
    data.phone = extracted.phone;
    data.whatsapp = extracted.phone;
  }
  if (extracted.phoneRaw) data.phoneRaw = extracted.phoneRaw;
  if (extracted.countryCode) data.countryCode = extracted.countryCode;
  if (extracted.email) data.email = extracted.email;
  if (extracted.agency) data.agency = extracted.agency;
  if (extracted.requirement) data.requirement = extracted.requirement;
  if (extracted.location) data.location = extracted.location;
  if (extracted.budget !== '') data.budget = extracted.budget;

  var timestamp = extracted.timestamp;
  if (timestamp instanceof Date && !isNaN(timestamp.getTime())) timestamp = timestamp.toISOString();
  else timestamp = String(timestamp || new Date().toISOString());

  data.source = 'Google Form';
  data.role = role;
  data.type = role;
  data.lead_type = role;
  data.customer_type = role;
  data._eph_role = role;
  data.formResponseId = extracted.responseId;
  data.ephSourceKey = extracted.sourceKey;
  data.formSubmittedAt = timestamp;
  data.formSourceSpreadsheet = sourceSpreadsheet.getName();
  data.formSourceSpreadsheetId = sourceSpreadsheet.getId();
  data.formSourceSheet = sourceSheet.getName();
  data.formSourceSheetId = String(sourceSheet.getSheetId());
  data.formSourceRow = rowNumber;
  if (!data.status) data.status = role === 'agent' ? 'Active' : 'New';

  var destination = role === 'agent' ? 'crm_records' : 'crm_leads';
  var stableId = ephFormStableIdV3_(sourceSpreadsheet, sourceSheet, headers, values, data);
  var now = new Date().toISOString();
  var lock = LockService.getUserLock();
  lock.waitLock(20000);
