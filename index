              ' / row ' + row + ': ' + String(err)
            );
          }
        }
      });
    } catch (err) {
      report.errors.push(file.getName() + ': ' + String(err));
    }
  }

  console.log(JSON.stringify(report, null, 2));
  return report;
}

function ephSyncOneEphFormResponse_(sourceSpreadsheet, sourceSheet, rowNumber) {
  if (rowNumber < 2 || rowNumber > sourceSheet.getLastRow()) {
    return {synced: false, reason: 'Not a response row'};
  }

  const lastCol = sourceSheet.getLastColumn();
  const headers = sourceSheet.getRange(1, 1, 1, lastCol)
    .getDisplayValues()[0];
  const values = sourceSheet.getRange(rowNumber, 1, 1, lastCol)
    .getValues()[0];

  if (!values.some(v => v !== '' && v !== null)) {
    return {synced: false, reason: 'Empty row'};
  }

  const roleIndex = ephFormFindHeader_(headers, [
    'Role', 'User Role', '角色', '申请类型'
  ]);

  const responseIdIndex = ephFormFindHeader_(headers, [
    'Form Response ID'
  ]);

  const sourceKeyIndex = ephFormFindHeader_(headers, [
    'EPH Source Key'
  ]);

  const answersIndex = ephFormFindHeader_(headers, [
    'Answers JSON', '完整答案', 'Answers'
  ]);

  const roleText = roleIndex >= 0 ? String(values[roleIndex] || '') : '';
  const locationText = (
    sourceSpreadsheet.getName() + ' ' + sourceSheet.getName()
  ).toLowerCase();

  const headerText = headers.map(h => String(h || '')).join(' ');
  const explicitRole = (roleText + ' ' + locationText).toLowerCase();
  const headerClues = headerText.toLowerCase();
  let role = '';

  // First trust the submitted role or form/sheet name. Only fall back to
  // column labels when the form does not provide an explicit role.
  if (/\bagent\b|\bbroker\b|经纪/.test(explicitRole)) role = 'agent';
  else if (/\btenant\b|租客|租户/.test(explicitRole)) role = 'tenant';
  else if (/\bbuyer\b|买家|买方/.test(explicitRole)) role = 'buyer';
  else if (/agent\s*\/\s*broker|agent\s*name|agent\s*phone|agency\s*\/\s*company|中介公司|经纪姓名/.test(headerClues)) role = 'agent';
  else if (/tenant|租客|租户|租赁需求/.test(headerClues)) role = 'tenant';
  else if (/buyer|买家|买方|购房需求/.test(headerClues)) role = 'buyer';

  if (!role) {
    console.warn(
      'Skipped response: could not determine Agent, Buyer or Tenant role. ' +
      sourceSpreadsheet.getName() + ' / ' + sourceSheet.getName() +
      ' / row ' + rowNumber
    );
    return {synced: false, reason: 'Unknown role'};
  }

  // Prefer the structured answers JSON, if supplied by the Form workflow.
  let data = {};

  if (answersIndex >= 0 && values[answersIndex]) {
    try {
      const parsed = typeof values[answersIndex] === 'object'
        ? values[answersIndex]
        : JSON.parse(String(values[answersIndex]));

      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
        data = Object.assign({}, parsed);
      }
    } catch (err) {
      console.warn('Answers JSON could not be parsed; using response columns.');
    }
  }

  // Add named response columns while excluding internal tracking fields.
  headers.forEach((header, i) => {
    const name = String(header || '').trim();
    const normalized = ephFormNormalizeHeader_(name);

    if (!name || values[i] === '' || values[i] === null) return;
    if (normalized === 'timestamp' || normalized === '时间戳') return;
    if (normalized === 'formresponseid' || normalized === 'ephsourcekey') return;
    if (normalized === 'answersjson' || normalized === '完整答案') return;

    if (data[name] === undefined) data[name] = values[i];
  });

  const responseId = responseIdIndex >= 0
    ? String(values[responseIdIndex] || '').trim()
    : '';

  const sourceKey = sourceKeyIndex >= 0
    ? String(values[sourceKeyIndex] || '').trim()
    : '';

  const uniqueSource = [
    sourceSpreadsheet.getId(),
    sourceSheet.getSheetId(),
    sourceKey || responseId || (
      String(values[0]) + '|' + JSON.stringify(data)
    )
  ].join('|');

  const digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    uniqueSource,
    Utilities.Charset.UTF_8
  );

  const stableId = 'FORM_' +
    Utilities.base64EncodeWebSafe(digest).replace(/=+$/g, '').slice(0, 32);

  const timestamp = values[0] instanceof Date
    ? values[0].toISOString()
    : String(values[0] || new Date().toISOString());

  data.source = 'Google Form';
  data.role = role;
  data.type = role;
  data.formResponseId = responseId;
  data.ephSourceKey = sourceKey;
  data.formSubmittedAt = timestamp;
  data.formSourceSpreadsheet = sourceSpreadsheet.getName();
  data.formSourceSheet = sourceSheet.getName();

  const now = new Date().toISOString();

  if (role === 'agent') {
    // Agent records go into the existing CRM records table.
    handleRest_('crm_records', 'on_conflict=id', 'POST', {
      id: stableId,
      kind: 'agent',
      data: data,
      backup_at: now
    });
  } else {
    // Buyer and Tenant records go into the existing Customer Leads table.
    handleRest_('crm_leads', 'on_conflict=id', 'POST', {
      id: stableId,
      data: data,
      updated_at: now
    });
  }

  return {
    synced: true,
    role: role,
    recordId: stableId,
    destination: role === 'agent' ? 'crm_records' : 'crm_leads'
  };
}
/**
 * Evelyn Property Hub â€” six independent ID sequences.
 * APPEND this file's contents to the BOTTOM of the EXISTING Code.gs.
 * Do not replace Code.gs. This patch does not delete or renumber existing records.
 *
 * Run ephRunIdSequenceSetupOnce() ONCE from the Apps Script editor.
 * It scans the CRM tables, initializes persistent counters, and logs a report.
 * Creation handlers must call ephNextDisplayId_(type, source) to assign IDs.
 */

var EPH_ID_SEQUENCE_RULES_20261028 = {
  agent_manual: { prefix: 'AB', width: 3 },
  agent_google_form: { prefix: 'AGBK', width: 3 },
  buyer_manual: { prefix: 'CB', width: 3 },
  buyer_google_form: { prefix: 'BYR', width: 3 },
  tenant_manual: { prefix: 'CT', width: 3 },
  tenant_google_form: { prefix: 'TNT', width: 3 }
};

function ephIdSequencePropertyKey_(sequenceName) {
  return 'EPH_IDSEQ_LAST_' + String(sequenceName).toUpperCase();
}

/**
 * ONE-TIME SETUP / AUDIT.
 * Scans existing CRM sheets for IDs, initializes counters to the highest found
 * number per prefix, and never changes any row or any listing table.
 */
function ephRunIdSequenceSetupOnce() {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var ss = getDatabase_();
    var tables = ['crm_leads', 'crm_records', 'crm_cobroke_requests'];
    var report = {
      ok: true,
      spreadsheetId: ss.getId(),
      spreadsheetUrl: ss.getUrl(),
      scannedTables: {},
      sequences: {},
      recordsChanged: 0,
      note: 'Audit only: no records changed; no listing sheets touched.'
    };
    var maxByPrefix = {};
    Object.keys(EPH_ID_SEQUENCE_RULES_20261028).forEach(function (name) {
      maxByPrefix[EPH_ID_SEQUENCE_RULES_20261028[name].prefix] = 0;
    });

    tables.forEach(function (tableName) {
      var sh = ss.getSheetByName(tableName);
      if (!sh || sh.getLastRow() < 2) {
        report.scannedTables[tableName] = 0;
        return;
      }
      var values = sh.getDataRange().getDisplayValues();
      var foundRows = 0;
      for (var r = 1; r < values.length; r++) {
        var rowHasData = values[r].some(function (v) { return String(v || '').trim() !== ''; });
        if (!rowHasData) continue;
        foundRows++;
        values[r].forEach(function (cell) {
          var text = String(cell == null ? '' : cell);
          Object.keys(maxByPrefix).forEach(function (prefix) {
            // Find exact prefix + digits anywhere in normal cells or serialized JSON.
            var re = new RegExp('(?:^|[^A-Za-z0-9])' + prefix + '(\\d+)(?=$|[^A-Za-z0-9])', 'g');
            var match;
            while ((match = re.exec(text)) !== null) {
              var n = Number(match[1]);
              if (Number.isFinite(n) && n > maxByPrefix[prefix]) maxByPrefix[prefix] = n;
            }
          });
        });
      }
      report.scannedTables[tableName] = foundRows;
    });

    var props = PropertiesService.getScriptProperties();
    Object.keys(EPH_ID_SEQUENCE_RULES_20261028).forEach(function (name) {
      var rule = EPH_ID_SEQUENCE_RULES_20261028[name];
      var key = ephIdSequencePropertyKey_(name);
      var existing = Number(props.getProperty(key) || 0) || 0;
      var highest = Math.max(existing, maxByPrefix[rule.prefix] || 0);
      props.setProperty(key, String(highest));
      report.sequences[name] = {
        prefix: rule.prefix,
        lastUsed: highest,
        nextPreview: rule.prefix + String(highest + 1).padStart(rule.width, '0'),
        property: key
      };
    });

    Logger.log(JSON.stringify(report, null, 2));
    return report;
  } finally {
    lock.releaseLock();
  }
}

/**
 * Generate the next persistent ID for a creation handler.
 * type: 'agent' | 'buyer' | 'tenant'
 * source: 'manual' | 'google_form'
 * Examples: ephNextDisplayId_('agent','manual') => AB001
 *           ephNextDisplayId_('agent','google_form') => AGBK001
 * Editing existing records must preserve their current ID and must NOT call this.
 */
function ephNextDisplayId_(type, source) {
  type = String(type || '').toLowerCase().trim();
  source = String(source || '').toLowerCase().trim();
  if (source === 'form' || source === 'google form' || source === 'googleform') source = 'google_form';
  if (source !== 'manual' && source !== 'google_form') {
    throw new Error('ID source must be exactly manual or google_form.');
  }
  if (type !== 'agent' && type !== 'buyer' && type !== 'tenant') {
    throw new Error('ID type must be agent, buyer, or tenant.');
  }
  var sequenceName = type + '_' + source;
  var rule = EPH_ID_SEQUENCE_RULES_20261028[sequenceName];
  if (!rule) throw new Error('ID sequence configuration is missing: ' + sequenceName);

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var props = PropertiesService.getScriptProperties();
    var key = ephIdSequencePropertyKey_(sequenceName);
    var current = Number(props.getProperty(key) || 0) || 0;
    var next = current + 1;
    props.setProperty(key, String(next));
    return rule.prefix + String(next).padStart(rule.width, '0');
  } finally {
    lock.releaseLock();
  }
}

/** Quick test only: previews each next ID without consuming any sequence number. */
function ephPreviewNextSixIds() {
  var props = PropertiesService.getScriptProperties();
  var result = {};
  Object.keys(EPH_ID_SEQUENCE_RULES_20261028).forEach(function (name) {
    var rule = EPH_ID_SEQUENCE_RULES_20261028[name];
    var last = Number(props.getProperty(ephIdSequencePropertyKey_(name)) || 0) || 0;
    result[name] = rule.prefix + String(last + 1).padStart(rule.width, '0');
  });
  Logger.log(JSON.stringify(result, null, 2));
  return result;
}
/**
 * Evelyn Property Hub â€” Google Form Agent request-ID repair.
 * APPEND this file to the existing Code.gs. Do not replace the whole backend.
 *
 * Repairs records like:
 *   Agent code: AGBK001
 *   googleFormRequestId: COBROKE-AB001-1792427955351
 * to:
 *   googleFormRequestId: COBROKE-AGBK001-1792427955351
 *
 * If the matching crm_cobroke_requests row uses the old COBROKE-AB... id and
 * its agent code is AGBK..., its id is updated to the same COBROKE-AGBK... value
 * so the CRM import marker and source row remain linked. Old IDs are retained in
 * legacyGoogleFormRequestId for audit. No listing table is read or changed.
 *
 * Run ephRunFixGoogleFormAgentRequestIdsOnce() once after backing up the sheet.
 */
function ephRunFixGoogleFormAgentRequestIdsOnce() {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var ss = getDatabase_();
    var recordsSheet = ss.getSheetByName('crm_records');
    var requestsSheet = ss.getSheetByName('crm_cobroke_requests');
    if (!recordsSheet || !requestsSheet) throw new Error('Required CRM sheets are missing. No changes made.');

    var records = readObjects_(recordsSheet);
    var requests = readObjects_(requestsSheet);
    var requestIds = new Set(requests.map(function(r){ return String(r.id || ''); }));
    var requestIdChanges = [];
    var recordMarkerChanges = [];
    var skipped = [];

    function newRequestId(oldId, agentCode) {
      oldId = String(oldId || '').trim();
      agentCode = String(agentCode || '').trim().toUpperCase();
      if (!/^COBROKE-AB\d+-\d+$/i.test(oldId) || !/^AGBK\d{3,}$/i.test(agentCode)) return '';
      return oldId.replace(/^COBROKE-AB\d+-/i, 'COBROKE-' + agentCode + '-');
    }

    // First build the exact mapping from legacy request IDs to corrected request IDs.
    requests.forEach(function(r) {
      var oldId = String(r.id || '').trim();
      var code = String(r.agent_code || r.crm_agent_code || r.displayCode || r.agentCode || '').trim();
      var corrected = newRequestId(oldId, code);
      if (!corrected || corrected === oldId) return;
      if (requestIds.has(corrected)) {
        skipped.push({table:'crm_cobroke_requests', id:oldId, reason:'Corrected ID already exists: ' + corrected});
        return;
      }
      requestIds.delete(oldId);
      requestIds.add(corrected);
      r.legacyGoogleFormRequestId = oldId;
      r.id = corrected;
      requestIdChanges.push({from:oldId, to:corrected, agentCode:code});
    });

    var mapping = {};
    requestIdChanges.forEach(function(x){ mapping[x.from] = x.to; });

    records.forEach(function(row) {
      if (String(row.kind || '').toLowerCase() !== 'agent') return;
      var d = row.data && typeof row.data === 'object' ? row.data : null;
      if (!d) return;
      var source = String(d.source || '').trim().toLowerCase();
      if (source !== 'google form') return;
      var oldMarker = String(d.googleFormRequestId || '').trim();
      if (!oldMarker) return;
      var code = String(d.displayCode || d.display_code || d.agent_code || d.agentCode || d.id || '').trim().toUpperCase();
      var corrected = mapping[oldMarker] || newRequestId(oldMarker, code);
      if (!corrected || corrected === oldMarker) return;
      d.legacyGoogleFormRequestId = oldMarker;
      d.googleFormRequestId = corrected;
      row.data = d;
      recordMarkerChanges.push({recordId:String(row.id || ''), agentCode:code, from:oldMarker, to:corrected});
    });

    // Do not write either table unless all edits have been prepared and collision-checked.
    if (requestIdChanges.length) writeObjects_(requestsSheet, requests);
    if (recordMarkerChanges.length) writeObjects_(recordsSheet, records);

    var result = {
      ok: true,
      finishedAt: new Date().toISOString(),
      crmCobrokeRequestIdsUpdated: requestIdChanges.length,
      crmRecordMarkersUpdated: recordMarkerChanges.length,
      skipped: skipped,
      requestIdChanges: requestIdChanges,
      recordMarkerChanges: recordMarkerChanges,
      listingTablesTouched: false,
      note: 'Only Google Form Agent request IDs and matching import markers were repaired. Agent display IDs remain AGBK...; manual AB... records are not renumbered.'
    };
    Logger.log(JSON.stringify(result, null, 2));
    return result;
  } finally {
    lock.releaseLock();
  }
}

/**
 * Use this helper when creating a Google Form Agent request ID in future code.
 * Pass the AGBK display code and a unique numeric/time suffix.
 * Example: ephGoogleFormAgentRequestId_('AGBK001', '1792427955351')
 * returns COBROKE-AGBK001-1792427955351.
 */
function ephGoogleFormAgentRequestId_(agentCode, uniqueSuffix) {
  var code = String(agentCode || '').trim().toUpperCase();
  var suffix = String(uniqueSuffix || '').trim();
  if (!/^AGBK\d{3,}$/.test(code)) throw new Error('Google Form Agent code must use AGBK### format.');
  if (!/^[A-Za-z0-9_-]+$/.test(suffix)) throw new Error('A valid unique suffix is required.');
